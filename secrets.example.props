<!-- Copy to secrets.props (git-ignored) to build NotchHub with the built-in Google sign-in.
     CI: set repository secrets NOTCHHUB_GOOGLE_CLIENT_ID / NOTCHHUB_GOOGLE_CLIENT_SECRET (see .github/workflows/release.yml). -->
<Project>
  <PropertyGroup>
    <NotchHubGoogleClientId>xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com</NotchHubGoogleClientId>
    <NotchHubGoogleClientSecret>GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx</NotchHubGoogleClientSecret>
  </PropertyGroup>
</Project>
