<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- CA1416 platform analyzer noise: every Windows project targets a Windows TFM anyway -->
    <NoWarn>$(NoWarn);CA1416;NETSDK1206</NoWarn>
    <!-- TFM used by every Windows-specific project (WinRT projections included) -->
    <WindowsTfm>net10.0-windows10.0.22621.0</WindowsTfm>
    <Company>NotchHub</Company>
    <Product>NotchHub</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
