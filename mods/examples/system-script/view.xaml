<!--
  Widok widżetu "Mój komputer". Dane pochodzą z info.ps1 (JSON na standardowym wyjściu), np.:
    { "computer": "PC", "uptimeText": "3 h 12 min", "memoryUsedGb": 15.3, "memoryTotalGb": 31.7,
      "memoryFraction": 0.48, "hasBattery": false, "batteryPercent": null, ... }
  Binding do pól obiektu: {Binding Data.nazwaPola}.
-->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="clr-namespace:NotchHub.UI.Controls;assembly=NotchHub.UI"
      xmlns:conv="clr-namespace:NotchHub.UI.Converters;assembly=NotchHub.UI"
      TextElement.Foreground="{DynamicResource Brush.OnSurface}">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- header -->
    <DockPanel Margin="4,0,0,14">
        <ui:IconButton DockPanel.Dock="Right" Icon="refresh" Variant="Tonal" Size="40" Command="{Binding Refresh}"
                       IsEnabled="{Binding IsLoading, Converter={conv:InverseBool}}" />
        <ui:LoadingIndicator DockPanel.Dock="Right" Size="32" Margin="0,0,10,0" IsActive="{Binding IsLoading}"
                             Visibility="{Binding IsLoading, Converter={conv:BoolToVisibility}}" />
        <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource Brush.Tertiary}" Margin="0,0,14,0">
            <ui:Icon Glyph="computer" Size="24" Filled="True" Foreground="{DynamicResource Brush.OnTertiary}" />
        </Border>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{DynamicResource Text.TitleL}" Text="{Binding Data.computer, FallbackValue='Mój komputer'}" />
            <TextBlock Style="{DynamicResource Text.BodyS}" Text="{Binding Data.os}" />
        </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- uptime -->
        <Border Style="{DynamicResource Card}" CornerRadius="28" Background="{DynamicResource Brush.PrimaryContainer}"
                TextElement.Foreground="{DynamicResource Brush.OnPrimaryContainer}">
            <StackPanel>
                <ui:Icon Glyph="schedule" Size="28" HorizontalAlignment="Left" Foreground="{DynamicResource Brush.OnPrimaryContainer}" />
                <TextBlock Style="{DynamicResource Text.Label}" Margin="0,12,0,0" Text="Czas pracy" />
                <TextBlock Style="{DynamicResource Text.Headline}" Text="{Binding Data.uptimeText}" />
                <TextBlock Style="{DynamicResource Text.Body}" Opacity="0.75" Margin="0,4,0,0">
                    <Run Text="od " /><Run Text="{Binding Data.bootTime, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- memory: WavyRing gauge (Value 0..1) -->
        <Border Grid.Column="2" Style="{DynamicResource Card}" CornerRadius="28">
            <DockPanel>
                <ui:WavyRing DockPanel.Dock="Right" Width="84" Height="84" Value="{Binding Data.memoryFraction, FallbackValue=0}"
                             ActiveBrush="{DynamicResource Brush.Gauge.Ram}">
                    <TextBlock Style="{DynamicResource Text.Number}" Text="{Binding Data.memoryPercent, StringFormat={}{0:0}%}" />
                </ui:WavyRing>
                <StackPanel VerticalAlignment="Center">
                    <ui:Icon Glyph="memory" Size="28" HorizontalAlignment="Left" Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                    <TextBlock Style="{DynamicResource Text.Label}" Margin="0,12,0,0" Text="Pamięć" />
                    <TextBlock Style="{DynamicResource Text.BodyS}">
                        <Run Text="{Binding Data.memoryUsedGb, Mode=OneWay, StringFormat={}{0:0.0}}" /><Run Text=" / " /><Run Text="{Binding Data.memoryTotalGb, Mode=OneWay, StringFormat={}{0:0.0}}" /><Run Text=" GB" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- battery (desktops have none) -->
        <Border Grid.Column="4" Style="{DynamicResource Card}" CornerRadius="28" Background="{DynamicResource Brush.SecondaryContainer}"
                TextElement.Foreground="{DynamicResource Brush.OnSecondaryContainer}">
            <Grid>
                <StackPanel Visibility="{Binding Data.hasBattery, Converter={conv:BoolToVisibility}, FallbackValue=Collapsed}">
                    <ui:Icon Glyph="battery_full" Size="28" HorizontalAlignment="Left" Foreground="{DynamicResource Brush.OnSecondaryContainer}" />
                    <TextBlock Style="{DynamicResource Text.Label}" Margin="0,12,0,0" Text="Bateria" />
                    <TextBlock Style="{DynamicResource Text.Headline}" Text="{Binding Data.batteryPercent, StringFormat={}{0:0}%}" />
                </StackPanel>
                <StackPanel Visibility="{Binding Data.hasBattery, Converter={conv:BoolToVisibility}, ConverterParameter=Invert, FallbackValue=Collapsed}">
                    <ui:Icon Glyph="power" Size="28" HorizontalAlignment="Left" Foreground="{DynamicResource Brush.OnSecondaryContainer}" />
                    <TextBlock Style="{DynamicResource Text.Label}" Margin="0,12,0,0" Text="Zasilanie" />
                    <TextBlock Style="{DynamicResource Text.Headline}" Text="Sieciowe" />
                    <TextBlock Style="{DynamicResource Text.Body}" Opacity="0.75" Margin="0,4,0,0">
                        <Run Text="{Binding Data.processes, Mode=OneWay}" /><Run Text=" procesów" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <!-- footer -->
    <Grid Grid.Row="2" Margin="4,12,0,0">
        <StackPanel Orientation="Horizontal" Visibility="{Binding Error, Converter={conv:NullToVisibility}}">
            <ui:Icon Glyph="error" Size="16" Foreground="{DynamicResource Brush.Error}" Margin="0,0,8,0" />
            <TextBlock Style="{DynamicResource Text.BodyS}" Foreground="{DynamicResource Brush.Error}" Text="{Binding Error}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Style="{DynamicResource Text.LabelS}" Visibility="{Binding Error, Converter={conv:NullToVisibility}, ConverterParameter=Invert}">
            <Run Text="Źródło: info.ps1 (polecenie lokalne) · odświeżono " /><Run Text="{Binding UpdatedAt, StringFormat={}{0:HH:mm:ss}, Mode=OneWay}" />
        </TextBlock>
    </Grid>
</Grid>
