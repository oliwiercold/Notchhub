<!--
  Widok widżetu "Kursy NBP". DataContext = WidgetDataContext:
    Data       – odpowiedź JSON (tablica → lista, obiekt → właściwości po nazwie), tutaj Data[0].rates[7].mid
    IsLoading  – true w trakcie pobierania
    Error      – komunikat błędu albo null
    UpdatedAt  – czas ostatniego udanego odświeżenia
    Refresh    – komenda (przycisk "odśwież")
  Kolory i style pochodzą z motywu aplikacji (DynamicResource Brush.* / Text.*), więc widżet zmienia się razem z motywem.
-->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="clr-namespace:NotchHub.UI.Controls;assembly=NotchHub.UI"
      xmlns:conv="clr-namespace:NotchHub.UI.Converters;assembly=NotchHub.UI"
      TextElement.Foreground="{DynamicResource Brush.OnSurface}">
    <Grid.Resources>
        <!-- one currency card -->
        <Style x:Key="RateCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinHeight" Value="150" />
        </Style>
        <Style x:Key="Symbol" TargetType="Border">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- header -->
    <DockPanel Margin="4,0,0,14">
        <ui:IconButton DockPanel.Dock="Right" Icon="refresh" Variant="Tonal" Size="40" Command="{Binding Refresh}"
                       IsEnabled="{Binding IsLoading, Converter={conv:InverseBool}}" ToolTip="Odśwież" />
        <ui:LoadingIndicator DockPanel.Dock="Right" Size="32" Margin="0,0,10,0" IsActive="{Binding IsLoading}"
                             Visibility="{Binding IsLoading, Converter={conv:BoolToVisibility}}" />
        <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource Brush.Primary}" Margin="0,0,14,0">
            <ui:Icon Glyph="currency_exchange" Size="24" Filled="True" Foreground="{DynamicResource Brush.OnPrimary}" />
        </Border>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{DynamicResource Text.TitleL}" Text="Kursy walut NBP" />
            <TextBlock Style="{DynamicResource Text.BodyS}">
                <Run Text="Tabela " /><Run Text="{Binding Data[0].no, Mode=OneWay}" />
                <Run Text=" · " /><Run Text="{Binding Data[0].effectiveDate, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>
    </DockPanel>

    <!-- 4 currency cards -->
    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,-10,0">
        <!-- EUR = rates[7] -->
        <Border Style="{StaticResource RateCard}" Background="{DynamicResource Brush.PrimaryContainer}"
                TextElement.Foreground="{DynamicResource Brush.OnPrimaryContainer}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Symbol}" Background="{DynamicResource Brush.Primary}">
                    <TextBlock Text="€" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.OnPrimary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock DockPanel.Dock="Top" Style="{DynamicResource Text.Title}" Margin="0,12,0,0" Text="{Binding Data[0].rates[7].code}" />
                <TextBlock DockPanel.Dock="Top" Style="{DynamicResource Text.Body}" Opacity="0.75" Text="{Binding Data[0].rates[7].currency}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,10,0,0">
                    <TextBlock Style="{DynamicResource Text.Headline}" Text="{Binding Data[0].rates[7].mid, StringFormat={}{0:0.0000}, Mode=OneWay}" />
                    <TextBlock Text=" zł" FontSize="14" Margin="0,0,0,5" VerticalAlignment="Bottom" />
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- USD = rates[1] -->
        <Border Style="{StaticResource RateCard}" Background="{DynamicResource Brush.SecondaryContainer}"
                TextElement.Foreground="{DynamicResource Brush.OnSecondaryContainer}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Symbol}" Background="{DynamicResource Brush.Secondary}">
                    <TextBlock Text="$" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.OnSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock DockPanel.Dock="Top" Style="{DynamicResource Text.Title}" Margin="0,12,0,0" Text="{Binding Data[0].rates[1].code}" />
                <TextBlock DockPanel.Dock="Top" Style="{DynamicResource Text.Body}" Opacity="0.75" Text="{Binding Data[0].rates[1].currency}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,10,0,0">
                    <TextBlock Style="{DynamicResource Text.Headline}" Text="{Binding Data[0].rates[1].mid, StringFormat={}{0:0.0000}, Mode=OneWay}" />
                    <TextBlock Text=" zł" FontSize="14" Margin="0,0,0,5" VerticalAlignment="Bottom" />
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- GBP = rates[10] -->
        <Border Style="{StaticResource RateCard}" Background="{DynamicResource Brush.TertiaryContainer}"
                TextElement.Foreground="{DynamicResource Brush.OnTertiaryContainer}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Symbol}" Background="{DynamicResource Brush.Tertiary}">
                    <TextBlock Text="£" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.OnTertiary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock DockPanel.Dock="Top" Style="{DynamicResource Text.Title}" Margin="0,12,0,0" Text="{Binding Data[0].rates[10].code}" />
                <TextBlock DockPanel.Dock="Top" Style="{DynamicResource Text.Body}" Opacity="0.75" Text="{Binding Data[0].rates[10].currency}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,10,0,0">
                    <TextBlock Style="{DynamicResource Text.Headline}" Text="{Binding Data[0].rates[10].mid, StringFormat={}{0:0.0000}, Mode=OneWay}" />
                    <TextBlock Text=" zł" FontSize="14" Margin="0,0,0,5" VerticalAlignment="Bottom" />
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- CHF = rates[9] -->
        <Border Style="{StaticResource RateCard}" Background="{DynamicResource Brush.Surface2}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Symbol}" Background="{DynamicResource Brush.Surface3}">
                    <TextBlock Text="₣" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock DockPanel.Dock="Top" Style="{DynamicResource Text.Title}" Margin="0,12,0,0" Text="{Binding Data[0].rates[9].code}" />
                <TextBlock DockPanel.Dock="Top" Style="{DynamicResource Text.BodyS}" Text="{Binding Data[0].rates[9].currency}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,10,0,0">
                    <TextBlock Style="{DynamicResource Text.Headline}" Text="{Binding Data[0].rates[9].mid, StringFormat={}{0:0.0000}, Mode=OneWay}" />
                    <TextBlock Text=" zł" FontSize="14" Margin="0,0,0,5" VerticalAlignment="Bottom" />
                </StackPanel>
            </DockPanel>
        </Border>
    </UniformGrid>

    <!-- footer: error or source + last update -->
    <Grid Grid.Row="2" Margin="4,12,0,0">
        <StackPanel Orientation="Horizontal" Visibility="{Binding Error, Converter={conv:NullToVisibility}}">
            <ui:Icon Glyph="error" Size="16" Foreground="{DynamicResource Brush.Error}" Margin="0,0,8,0" />
            <TextBlock Style="{DynamicResource Text.BodyS}" Foreground="{DynamicResource Brush.Error}" Text="{Binding Error}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Style="{DynamicResource Text.LabelS}" Visibility="{Binding Error, Converter={conv:NullToVisibility}, ConverterParameter=Invert}">
            <Run Text="Źródło: api.nbp.pl · średnie kursy, tabela A · odświeżono " /><Run Text="{Binding UpdatedAt, StringFormat={}{0:HH:mm}, Mode=OneWay}" />
        </TextBlock>
    </Grid>
</Grid>
