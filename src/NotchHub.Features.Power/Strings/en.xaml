<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="power.lock">Lock</sys:String>
    <sys:String x:Key="power.sleep">Sleep</sys:String>
    <sys:String x:Key="power.restart">Restart</sys:String>
    <sys:String x:Key="power.shutdown">Shut down</sys:String>
    <sys:String x:Key="power.clickAgain">Click again</sys:String>
</ResourceDictionary>
