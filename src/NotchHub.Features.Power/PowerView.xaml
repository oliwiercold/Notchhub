<UserControl x:Class="NotchHub.Features.Power.PowerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:NotchHub.UI.Controls;assembly=NotchHub.UI"
             xmlns:conv="clr-namespace:NotchHub.UI.Converters;assembly=NotchHub.UI"
             xmlns:local="clr-namespace:NotchHub.Features.Power"
             x:Name="Root" Width="792">
    <UserControl.Resources>
        <Style x:Key="PowerTileButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Base" CornerRadius="24" Background="{DynamicResource Brush.Surface2}" />
                            <Border x:Name="Danger" CornerRadius="24" Background="{DynamicResource Brush.ErrorContainer}" Opacity="0" />
                            <Border x:Name="State" CornerRadius="24" Background="{DynamicResource Brush.StateHover}" Opacity="0" />
                            <Border x:Name="Focus" CornerRadius="24" BorderThickness="2" BorderBrush="{DynamicResource Brush.Primary}" Visibility="Collapsed" />
                            <ContentPresenter Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="State" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="State" Property="Background" Value="{DynamicResource Brush.StatePressed}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsArmed}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.OnErrorContainer}" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Danger" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Danger" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ItemsControl ItemsSource="{Binding Tiles}" Margin="-5,0" Focusable="False">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:PowerTile}">
                <Button Style="{StaticResource PowerTileButton}" Height="112" Margin="5,0" local:Press.Squish="0.06"
                        Command="{Binding DataContext.ActivateCommand, ElementName=Root}" CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding Label}">
                    <StackPanel>
                        <Grid Width="52" Height="52" HorizontalAlignment="Center">
                            <ui:WavyRing Value="{Binding Countdown}" Thickness="4" WaveCount="8" Amplitude="1.2"
                                         ActiveBrush="{DynamicResource Brush.Error}" TrackBrush="{DynamicResource Brush.OutlineVariant}"
                                         Visibility="{Binding IsArmed, Converter={conv:BoolToVisibility}}" />
                            <ui:Icon Glyph="{Binding Icon}" Size="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,8,0,0" HorizontalAlignment="Center">
                            <TextBlock Style="{DynamicResource Text.Title}" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding IsArmed, Converter={conv:BoolToVisibility}, ConverterParameter=Invert}" />
                            <TextBlock Style="{DynamicResource Text.Title}" Text="{DynamicResource power.clickAgain}" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding IsArmed, Converter={conv:BoolToVisibility}}" />
                        </Grid>
                    </StackPanel>
                </Button>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
