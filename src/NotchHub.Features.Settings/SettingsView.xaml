<UserControl x:Class="NotchHub.Features.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:NotchHub.UI.Controls;assembly=NotchHub.UI"
             xmlns:conv="clr-namespace:NotchHub.UI.Converters;assembly=NotchHub.UI"
             xmlns:local="clr-namespace:NotchHub.Features.Settings"
             Foreground="{DynamicResource Brush.OnSurface}"
             Height="520">
    <UserControl.Resources>
        <!-- Row: icon circle, title + description, control on the right -->
        <Style TargetType="local:SettingRow">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:SettingRow">
                        <Grid MinHeight="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="IconBox" Width="36" Height="36" CornerRadius="18" Margin="0,0,12,0" VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.Surface3}">
                                <ui:Icon Glyph="{TemplateBinding Icon}" Size="20" Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Style="{DynamicResource Text.Body}" Text="{TemplateBinding Title}" TextWrapping="Wrap" />
                                <TextBlock x:Name="Desc" Style="{DynamicResource Text.BodyS}" Text="{TemplateBinding Description}" TextWrapping="Wrap" Margin="0,1,0,0" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Icon" Value="">
                                <Setter TargetName="IconBox" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Description" Value="{x:Null}">
                                <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Single-choice chip group -->
        <Style x:Key="Chips" TargetType="ItemsControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate DataType="local:Choice">
                        <ToggleButton Style="{DynamicResource FilterChip}" Margin="0,4,8,4" Content="{Binding Label}"
                                      IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding PickCommand}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Press squish for custom tappables -->
        <Style x:Key="Tappable" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.92" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.92" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.45">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase Oscillations="1" Springiness="5" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.45">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase Oscillations="1" Springiness="5" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small color dot (presets) -->
        <DataTemplate x:Key="DotTemplate" DataType="local:ColorDot">
            <Button Style="{StaticResource Tappable}" Command="{Binding PickCommand}" Margin="0,0,8,0" ToolTip="{Binding Hex}">
                <Grid Width="28" Height="28">
                    <Ellipse x:Name="Ring" Stroke="{DynamicResource Brush.OnSurface}" StrokeThickness="2" Visibility="Hidden" />
                    <Ellipse Margin="4" Fill="{Binding Brush}" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Removable text item -->
        <DataTemplate x:Key="TextItemTemplate" DataType="local:TextItem">
            <Border Background="{DynamicResource Brush.Surface3}" CornerRadius="10" Height="32" Margin="0,4,8,4" Padding="12,0,4,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{DynamicResource Text.Label}" Text="{Binding Text}" VerticalAlignment="Center" />
                    <ui:IconButton Icon="close" Size="32" Variant="Standard" Margin="2,0,0,0" Command="{Binding RemoveCommand}" />
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ───────── navigation ───────── -->
        <Border Style="{DynamicResource CardTight}" Margin="0,0,12,0" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{DynamicResource Text.TitleL}" Text="{DynamicResource settings.Title}" Margin="12,6,0,10" />
                <ListBox x:Name="Nav" ItemContainerStyle="{DynamicResource ListRow}" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource Brush.OnSurface}" SelectedIndex="{Binding SectionIndex, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnNavChanged">
                    <StackPanel Orientation="Horizontal"><ui:Icon Glyph="palette" Margin="0,0,12,0" /><TextBlock Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Text="{DynamicResource settings.Nav.Appearance}" /></StackPanel>
                    <StackPanel Orientation="Horizontal"><ui:Icon Glyph="vertical_align_top" Margin="0,0,12,0" /><TextBlock Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Text="{DynamicResource settings.Nav.Notch}" /></StackPanel>
                    <StackPanel Orientation="Horizontal"><ui:Icon Glyph="keyboard" Margin="0,0,12,0" /><TextBlock Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Text="{DynamicResource settings.Nav.Shortcuts}" /></StackPanel>
                    <StackPanel Orientation="Horizontal"><ui:Icon Glyph="content_paste" Margin="0,0,12,0" /><TextBlock Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Text="{DynamicResource settings.Nav.Clipboard}" /></StackPanel>
                    <StackPanel Orientation="Horizontal"><ui:Icon Glyph="partly_cloudy_day" Margin="0,0,12,0" /><TextBlock Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Text="{DynamicResource settings.Nav.Weather}" /></StackPanel>
                    <StackPanel Orientation="Horizontal"><ui:Icon Glyph="event" Margin="0,0,12,0" /><TextBlock Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Text="{DynamicResource settings.Nav.Calendar}" /></StackPanel>
                    <StackPanel Orientation="Horizontal"><ui:Icon Glyph="event_upcoming" Margin="0,0,12,0" /><TextBlock Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Text="{DynamicResource settings.Nav.Meeting}" /></StackPanel>
                    <StackPanel Orientation="Horizontal"><ui:Icon Glyph="smartphone" Margin="0,0,12,0" /><TextBlock Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Text="{DynamicResource settings.Nav.Phone}" /></StackPanel>
                    <StackPanel Orientation="Horizontal"><ui:Icon Glyph="extension" Margin="0,0,12,0" /><TextBlock Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Text="{DynamicResource settings.Nav.Mods}" /></StackPanel>
                    <StackPanel Orientation="Horizontal"><ui:Icon Glyph="settings" Margin="0,0,12,0" /><TextBlock Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Text="{DynamicResource settings.Nav.General}" /></StackPanel>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ───────── content ───────── -->
        <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid Margin="0,0,8,8">

                <!-- ═════ Wygląd ═════ -->
                <StackPanel Visibility="{Binding Section, Converter={conv:EnumEquals}, ConverterParameter=Appearance}">
                    <TextBlock Style="{DynamicResource Text.Overline}" Text="{DynamicResource settings.Appearance.ColorSource}" Margin="4,2,0,8" />
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding SourceSwatches}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="local:Swatch">
                                        <Button Style="{StaticResource Tappable}" Command="{Binding PickCommand}" Margin="0,0,8,8">
                                            <Border x:Name="Card" Width="80" Height="98" CornerRadius="20" Background="{DynamicResource Brush.Surface2}">
                                                <StackPanel VerticalAlignment="Center">
                                                    <Grid Width="56" Height="56">
                                                        <Grid Width="48" Height="48">
                                                            <Grid.Clip>
                                                                <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24" />
                                                            </Grid.Clip>
                                                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                            <Rectangle Grid.ColumnSpan="2" Fill="{Binding A}" />
                                                            <Rectangle Grid.Row="1" Fill="{Binding B}" />
                                                            <Rectangle Grid.Row="1" Grid.Column="1" Fill="{Binding C}" />
                                                        </Grid>
                                                        <Ellipse x:Name="Ring" Stroke="{DynamicResource Brush.OnSurface}" StrokeThickness="2.5" Visibility="Hidden" />
                                                        <Border x:Name="Check" Width="22" Height="22" CornerRadius="11" Visibility="Hidden"
                                                                Background="{DynamicResource Brush.Surface1}">
                                                            <ui:Icon Glyph="check" Size="16" Foreground="{DynamicResource Brush.OnSurface}" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Style="{DynamicResource Text.LabelS}" Text="{Binding Label}" HorizontalAlignment="Center"
                                                               Margin="4,6,4,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.SecondaryContainer}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- custom color -->
                            <Grid Margin="0,4,0,0" Visibility="{Binding IsCustomSource, Converter={conv:BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{DynamicResource TextField}" ui:Field.Icon="colorize" ui:Field.Placeholder="#RRGGBB"
                                         Text="{Binding CustomHex, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnHexKeyDown" />
                                <ItemsControl Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Focusable="False"
                                              ItemsSource="{Binding PresetColors}" ItemTemplate="{StaticResource DotTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Grid>
                            <TextBlock Style="{DynamicResource Text.BodyS}" Foreground="{DynamicResource Brush.Error}" Margin="4,6,0,0"
                                       Text="{DynamicResource settings.Appearance.HexInvalid}"
                                       Visibility="{Binding CustomHexInvalid, Converter={conv:BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{DynamicResource Text.Overline}" Text="{DynamicResource settings.Appearance.Style}" Margin="4,16,0,8" />
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding VariantSwatches}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="local:Swatch">
                                        <ToggleButton Style="{DynamicResource FilterChip}" Margin="0,4,8,4" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                      Command="{Binding PickCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Grid Width="18" Height="18" Margin="0,0,8,0">
                                                    <Grid.Clip>
                                                        <EllipseGeometry Center="9,9" RadiusX="9" RadiusY="9" />
                                                    </Grid.Clip>
                                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <Rectangle Grid.ColumnSpan="2" Fill="{Binding A}" />
                                                    <Rectangle Grid.Row="1" Fill="{Binding B}" />
                                                    <Rectangle Grid.Row="1" Grid.Column="1" Fill="{Binding C}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Style="{DynamicResource Divider}" Margin="0,10" />
                            <local:SettingRow Icon="dark_mode" Title="{DynamicResource settings.Appearance.Panel}" Description="{DynamicResource settings.Appearance.PanelDesc}">
                                <ItemsControl Style="{StaticResource Chips}" ItemsSource="{Binding PanelStyles}" />
                            </local:SettingRow>
                            <TextBlock Style="{DynamicResource Text.Label}" Text="{DynamicResource settings.Appearance.Contrast}" Margin="0,10,0,6" />
                            <ui:M3Slider Icon="contrast" Minimum="-1" Maximum="1" SmallChange="0.1" TrackHeight="36" ShowValue="True"
                                         Value="{Binding Contrast}" ValueText="{Binding ContrastText}" />
                            <local:SettingRow Icon="animation" Margin="0,10,0,0" Title="{DynamicResource settings.Appearance.ReduceMotion}"
                                              Description="{DynamicResource settings.Appearance.ReduceMotionDesc}">
                                <ToggleButton Style="{DynamicResource Switch}" IsChecked="{Binding ReduceMotion}" />
                            </local:SettingRow>
                            <local:SettingRow Icon="motion_play" Title="{DynamicResource settings.Appearance.AnimStyle}"
                                              Description="{DynamicResource settings.Appearance.AnimStyleDesc}">
                                <ItemsControl Style="{StaticResource Chips}" ItemsSource="{Binding AnimationStyles}" />
                            </local:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═════ Notch ═════ -->
                <StackPanel Visibility="{Binding Section, Converter={conv:EnumEquals}, ConverterParameter=Notch}">
                    <!-- Prominent: reserve screen space -->
                    <Border CornerRadius="24" Padding="16" Margin="0,2,0,0" Background="{DynamicResource Brush.PrimaryContainer}"
                            TextElement.Foreground="{DynamicResource Brush.OnPrimaryContainer}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="14" Margin="0,0,14,0" Background="{DynamicResource Brush.Primary}" VerticalAlignment="Top">
                                    <ui:Icon Glyph="vertical_align_top" Size="24" Filled="True" Foreground="{DynamicResource Brush.OnPrimary}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{DynamicResource Text.TitleL}" Text="{DynamicResource settings.Notch.Reserve}" />
                                    <TextBlock Style="{DynamicResource Text.Body}" Opacity="0.8" TextWrapping="Wrap" Margin="0,2,12,0"
                                               Text="{DynamicResource settings.Notch.ReserveDesc}" />
                                </StackPanel>
                                <ToggleButton Grid.Column="2" Style="{DynamicResource Switch}" VerticalAlignment="Center" IsChecked="{Binding ReserveScreenSpace}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="58,10,0,0" IsEnabled="{Binding ReserveScreenSpace}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,10,0" Text="{DynamicResource settings.Notch.ReserveHeight}" />
                                <ItemsControl Style="{StaticResource Chips}" ItemsSource="{Binding ReservedSpaceModes}" />
                            </StackPanel>
                            <TextBlock Style="{DynamicResource Text.BodyS}" Foreground="{DynamicResource Brush.OnPrimaryContainer}" Opacity="0.75"
                                       Margin="58,6,0,0" TextWrapping="Wrap" Text="{DynamicResource settings.Notch.ReserveModesDesc}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{DynamicResource Text.Overline}" Text="{DynamicResource settings.Notch.Placement}" Margin="4,16,0,8" />
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <local:SettingRow Icon="desktop_windows" Title="{DynamicResource settings.Notch.Monitor}">
                                <ItemsControl Style="{StaticResource Chips}" ItemsSource="{Binding MonitorChoices}" MaxWidth="380" />
                            </local:SettingRow>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource Text.Label}" Text="{DynamicResource settings.Notch.Width}" Margin="0,0,0,6" />
                                    <ui:M3Slider Icon="width" Minimum="120" Maximum="400" SmallChange="5" TrackHeight="36" ShowValue="True"
                                                 Value="{Binding CollapsedWidth}" ValueText="{Binding CollapsedWidthText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{DynamicResource Text.Label}" Text="{DynamicResource settings.Notch.Height}" Margin="0,0,0,6" />
                                    <ui:M3Slider Icon="height" Minimum="6" Maximum="36" SmallChange="1" TrackHeight="36" ShowValue="True"
                                                 Value="{Binding CollapsedHeight}" ValueText="{Binding CollapsedHeightText}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{DynamicResource Text.Overline}" Text="{DynamicResource settings.Notch.Behavior}" Margin="4,16,0,8" />
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.Label}" Text="{DynamicResource settings.Notch.Hover}" Margin="0,0,0,2" />
                            <ItemsControl Style="{StaticResource Chips}" ItemsSource="{Binding HoverChoices}" />
                            <Grid Margin="0,8,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource Text.Label}" Text="{DynamicResource settings.Notch.HoverDelay}" Margin="0,0,0,6" />
                                    <ui:M3Slider Icon="mouse" Minimum="0" Maximum="1000" SmallChange="10" TrackHeight="36" ShowValue="True"
                                                 Value="{Binding HoverDelay}" ValueText="{Binding HoverDelayText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{DynamicResource Text.Label}" Text="{DynamicResource settings.Notch.CollapseDelay}" Margin="0,0,0,6" />
                                    <ui:M3Slider Icon="timer" Minimum="100" Maximum="2000" SmallChange="50" TrackHeight="36" ShowValue="True"
                                                 Value="{Binding CollapseDelay}" ValueText="{Binding CollapseDelayText}" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{DynamicResource Divider}" Margin="0,10,0,6" />
                            <local:SettingRow Icon="music_note" Title="{DynamicResource settings.Notch.LiveActivity}" Description="{DynamicResource settings.Notch.LiveActivityDesc}">
                                <ToggleButton Style="{DynamicResource Switch}" IsChecked="{Binding ShowLiveActivity}" />
                            </local:SettingRow>
                            <local:SettingRow Icon="view_agenda" Title="{DynamicResource settings.Notch.PeekGlance}" Description="{DynamicResource settings.Notch.PeekGlanceDesc}">
                                <ToggleButton Style="{DynamicResource Switch}" IsChecked="{Binding PeekGlanceWithMedia}" />
                            </local:SettingRow>
                            <local:SettingRow Icon="volume_up" Title="{DynamicResource settings.Notch.Hud}" Description="{DynamicResource settings.Notch.HudDesc}">
                                <ToggleButton Style="{DynamicResource Switch}" IsChecked="{Binding ShowHud}" />
                            </local:SettingRow>
                            <local:SettingRow Icon="swipe_down_alt" Title="{DynamicResource settings.Notch.Scroll}" Description="{DynamicResource settings.Notch.ScrollDesc}">
                                <ToggleButton Style="{DynamicResource Switch}" IsChecked="{Binding ScrollToExpand}" />
                            </local:SettingRow>
                            <local:SettingRow Icon="fullscreen_exit" Title="{DynamicResource settings.Notch.Fullscreen}" Description="{DynamicResource settings.Notch.FullscreenDesc}">
                                <ToggleButton Style="{DynamicResource Switch}" IsChecked="{Binding HideInFullscreen}" />
                            </local:SettingRow>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{DynamicResource Text.Overline}" Text="{DynamicResource settings.Notch.Tabs}" Margin="4,16,0,8" />
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.Label}" Text="{DynamicResource settings.Notch.DefaultTab}" Margin="0,0,0,2" />
                            <ItemsControl Style="{StaticResource Chips}" ItemsSource="{Binding TabChoices}" />
                            <local:SettingRow Icon="history" Margin="0,8,0,0" Title="{DynamicResource settings.Notch.RememberTab}" Description="{DynamicResource settings.Notch.RememberTabDesc}">
                                <ToggleButton Style="{DynamicResource Switch}" IsChecked="{Binding RememberLastTab}" />
                            </local:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═════ Skróty ═════ -->
                <StackPanel Visibility="{Binding Section, Converter={conv:EnumEquals}, ConverterParameter=Shortcuts}">
                    <TextBlock Style="{DynamicResource Text.Overline}" Text="{DynamicResource settings.Shortcuts.Header}" Margin="4,2,0,8" />
                    <Border Style="{DynamicResource Card}">
                        <ItemsControl ItemsSource="{Binding Hotkeys}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="local:HotkeyField">
                                    <StackPanel Margin="0,4">
                                        <local:SettingRow Icon="keyboard" Title="{Binding Title}">
                                            <ui:M3Button x:Name="Btn" Variant="Tonal" Size="M" MinWidth="200" Icon="keyboard_command_key"
                                                         Content="{Binding Display}" Command="{Binding StartCommand}" />
                                        </local:SettingRow>
                                        <TextBlock Style="{DynamicResource Text.BodyS}" Foreground="{DynamicResource Brush.Error}" Margin="48,0,0,4"
                                                   Text="{Binding Error}" Visibility="{Binding Error, Converter={conv:NullToVisibility}}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                            <Setter TargetName="Btn" Property="Variant" Value="Filled" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <Border Style="{DynamicResource CardFlat}" Margin="0,12,0,0" CornerRadius="20" Padding="16,12">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Glyph="info" Size="18" Foreground="{DynamicResource Brush.OnSurfaceVariant}" Margin="0,0,10,0" VerticalAlignment="Top" />
                            <TextBlock Style="{DynamicResource Text.BodyS}" TextWrapping="Wrap" MaxWidth="520" Text="{DynamicResource settings.Shortcuts.Hint}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═════ Schowek ═════ -->
                <StackPanel Visibility="{Binding Section, Converter={conv:EnumEquals}, ConverterParameter=Clipboard}">
                    <TextBlock Style="{DynamicResource Text.Overline}" Text="{DynamicResource settings.Clipboard.Header}" Margin="4,2,0,8" />
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <local:SettingRow Icon="content_paste" Title="{DynamicResource settings.Clipboard.Enabled}" Description="{DynamicResource settings.Clipboard.EnabledDesc}">
                                <ToggleButton Style="{DynamicResource Switch}" IsChecked="{Binding ClipEnabled}" />
                            </local:SettingRow>
                            <local:SettingRow Icon="image" Title="{DynamicResource settings.Clipboard.Images}">
                                <ToggleButton Style="{DynamicResource Switch}" IsChecked="{Binding ClipSaveImages}" />
                            </local:SettingRow>
                            <local:SettingRow Icon="shield" Title="{DynamicResource settings.Clipboard.Sensitive}" Description="{DynamicResource settings.Clipboard.SensitiveDesc}">
                                <ToggleButton Style="{DynamicResource Switch}" IsChecked="{Binding ClipIgnoreSensitive}" />
                            </local:SettingRow>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource Text.Label}" Text="{DynamicResource settings.Clipboard.MaxItems}" Margin="0,0,0,6" />
                                    <ui:M3Slider Icon="format_list_numbered" Minimum="50" Maximum="1000" SmallChange="50" TrackHeight="36" ShowValue="True"
                                                 Value="{Binding ClipMaxItems}" ValueText="{Binding ClipMaxItemsText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{DynamicResource Text.Label}" Text="{DynamicResource settings.Clipboard.Retention}" Margin="0,0,0,6" />
