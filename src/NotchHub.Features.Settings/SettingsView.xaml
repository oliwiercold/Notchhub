                            </local:SettingRow>
                            <local:SettingRow Icon="password" Title="{DynamicResource settings.Phone.OtpCopy}" Description="{DynamicResource settings.Phone.OtpCopyDesc}">
                                <ToggleButton Style="{DynamicResource Switch}" IsChecked="{Binding PhoneOtpCopy}" />
                            </local:SettingRow>
                            <TextBlock Style="{DynamicResource Text.Label}" Text="{DynamicResource settings.Phone.Muted}" Margin="0,10,0,4" />
                            <ItemsControl ItemsSource="{Binding MutedApps}" ItemTemplate="{StaticResource TextItemTemplate}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <DockPanel Margin="0,6,0,0">
                                <ui:M3Button DockPanel.Dock="Right" Margin="8,0,0,0" Variant="Tonal" Icon="add" Content="{DynamicResource settings.Add}"
                                             Command="{Binding AddMutedAppCommand}" />
                                <TextBox Style="{DynamicResource TextField}" ui:Field.Icon="notifications_off" ui:Field.Placeholder="{DynamicResource settings.Phone.MutedPlaceholder}"
                                         Text="{Binding NewMutedApp, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnMutedAppKeyDown" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═════ Mody ═════ -->
                <StackPanel Visibility="{Binding Section, Converter={conv:EnumEquals}, ConverterParameter=Mods}">
                    <!-- header card: folder + how-to -->
                    <Border CornerRadius="24" Padding="16" Margin="0,2,0,0" Background="{DynamicResource Brush.PrimaryContainer}"
                            TextElement.Foreground="{DynamicResource Brush.OnPrimaryContainer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="14" Margin="0,0,14,0" Background="{DynamicResource Brush.Primary}" VerticalAlignment="Top">
                                <ui:Icon Glyph="extension" Size="24" Filled="True" Foreground="{DynamicResource Brush.OnPrimary}" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{DynamicResource Text.TitleL}" Text="{DynamicResource settings.Mods.Title}" />
                                <TextBlock Style="{DynamicResource Text.Body}" Opacity="0.8" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="{DynamicResource settings.Mods.Desc}" />
                                <TextBlock Style="{DynamicResource Text.LabelS}" Foreground="{DynamicResource Brush.OnPrimaryContainer}" Opacity="0.7"
                                           Margin="0,6,0,0" Text="{Binding ModsFolder}" TextTrimming="CharacterEllipsis" />
                                <WrapPanel Margin="0,10,0,0">
                                    <ui:M3Button Variant="Filled" Size="S" Icon="folder_open" Margin="0,0,8,0"
                                                 Content="{DynamicResource settings.Mods.OpenFolder}" Command="{Binding OpenModsFolderCommand}" />
                                    <ui:M3Button Variant="Tonal" Size="S" Icon="menu_book"
                                                 Content="{DynamicResource settings.Mods.HowTo}" Command="{Binding OpenModGuideCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- inline quick guide (when MODDING.md is not shipped next to the exe) -->
                    <Border Style="{DynamicResource CardFlat}" Margin="0,12,0,0" CornerRadius="20" Padding="16,12"
                            Visibility="{Binding ShowModGuide, Converter={conv:BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.Title}" Text="{DynamicResource settings.Mods.GuideTitle}" Margin="0,0,0,6" />
                            <TextBlock Style="{DynamicResource Text.Body}" TextWrapping="Wrap" Text="{DynamicResource settings.Mods.Guide1}" />
                            <TextBlock Style="{DynamicResource Text.Body}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{DynamicResource settings.Mods.Guide2}" />
                            <TextBlock Style="{DynamicResource Text.Body}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{DynamicResource settings.Mods.Guide3}" />
                            <TextBlock Style="{DynamicResource Text.Body}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{DynamicResource settings.Mods.Guide4}" />
                            <TextBlock Style="{DynamicResource Text.BodyS}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{DynamicResource settings.Mods.GuideMore}" />
                        </StackPanel>
                    </Border>

                    <!-- restart hint -->
                    <Border Margin="0,12,0,0" CornerRadius="16" Padding="14,10" Background="{DynamicResource Brush.TertiaryContainer}"
                            TextElement.Foreground="{DynamicResource Brush.OnTertiaryContainer}"
                            Visibility="{Binding ModsRestartNeeded, Converter={conv:BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Glyph="restart_alt" Size="20" Foreground="{DynamicResource Brush.OnTertiaryContainer}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Style="{DynamicResource Text.Label}" Foreground="{DynamicResource Brush.OnTertiaryContainer}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Text="{DynamicResource settings.Mods.Restart}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{DynamicResource Text.Overline}" Text="{DynamicResource settings.Mods.Installed}" Margin="4,16,0,8" />
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Mods}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="local:ModItem">
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="IconBox" Width="40" Height="40" CornerRadius="14" Margin="0,0,12,0" VerticalAlignment="Top"
                                                    Background="{DynamicResource Brush.SecondaryContainer}">
                                                <ui:Icon Glyph="{Binding Icon}" Size="20" Foreground="{DynamicResource Brush.OnSecondaryContainer}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{DynamicResource Text.Title}" Text="{Binding Name}" VerticalAlignment="Center" />
                                                    <Border Margin="8,0,0,0" CornerRadius="8" Padding="7,1" VerticalAlignment="Center"
                                                            Background="{DynamicResource Brush.Surface3}">
                                                        <TextBlock Style="{DynamicResource Text.LabelS}" Text="{Binding KindLabel}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Style="{DynamicResource Text.LabelS}" Margin="0,2,0,0" Text="{Binding Meta}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{DynamicResource Text.BodyS}" Margin="0,3,0,0" Text="{Binding Description}" TextWrapping="Wrap"
                                                           Visibility="{Binding Description, Converter={conv:NullToVisibility}}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasError, Converter={conv:BoolToVisibility}}">
                                                    <ui:Icon Glyph="error" Size="14" Foreground="{DynamicResource Brush.Error}" Margin="0,0,6,0" VerticalAlignment="Top" />
                                                    <TextBlock Style="{DynamicResource Text.BodyS}" Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap"
                                                               MaxWidth="440" Text="{Binding Error}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="2" Style="{DynamicResource Switch}" VerticalAlignment="Center" IsChecked="{Binding IsEnabled}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                <Setter TargetName="IconBox" Property="Background" Value="{DynamicResource Brush.ErrorContainer}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding Mods.Count, Converter={conv:ZeroToCollapsed}, ConverterParameter=Invert}">
                                <ui:Icon Glyph="info" Size="18" Foreground="{DynamicResource Brush.OnSurfaceVariant}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                <TextBlock Style="{DynamicResource Text.BodyS}" TextWrapping="Wrap" MaxWidth="500" Text="{DynamicResource settings.Mods.Empty}" />
                            </StackPanel>
                            <TextBlock Style="{DynamicResource Text.LabelS}" Margin="0,10,0,0" TextWrapping="Wrap" Text="{DynamicResource settings.Mods.RestartHint}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{DynamicResource Text.Overline}" Text="{DynamicResource settings.Mods.Security}" Margin="4,16,0,8" />
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <local:SettingRow Icon="terminal" Title="{DynamicResource settings.Mods.AllowCommands}" Description="{DynamicResource settings.Mods.AllowCommandsDesc}">
                                <ToggleButton Style="{DynamicResource Switch}" IsChecked="{Binding AllowCommands}" />
                            </local:SettingRow>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ui:Icon Glyph="shield" Size="18" Foreground="{DynamicResource Brush.OnSurfaceVariant}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                <TextBlock Style="{DynamicResource Text.BodyS}" TextWrapping="Wrap" MaxWidth="520" Text="{DynamicResource settings.Mods.SecurityNote}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═════ Ogólne ═════ -->
                <StackPanel Visibility="{Binding Section, Converter={conv:EnumEquals}, ConverterParameter=General}">
                    <TextBlock Style="{DynamicResource Text.Overline}" Text="{DynamicResource settings.General.Header}" Margin="4,2,0,8" />
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <local:SettingRow Icon="translate" Title="{DynamicResource settings.General.Language}">
                                <ItemsControl Style="{StaticResource Chips}" ItemsSource="{Binding LanguageChoices}" />
                            </local:SettingRow>
                            <local:SettingRow Icon="rocket_launch" Title="{DynamicResource settings.General.Autostart}" Description="{DynamicResource settings.General.AutostartDesc}">
                                <ToggleButton Style="{DynamicResource Switch}" IsChecked="{Binding StartWithWindows}" />
                            </local:SettingRow>
                        </StackPanel>
                    </Border>

                    <!-- ───── Multimedia: Spotify (Web API, PKCE, user's own client id) ───── -->
                    <TextBlock Style="{DynamicResource Text.Overline}" Text="{DynamicResource settings.Spotify.Header}" Margin="4,16,0,8" />
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <local:SettingRow Icon="library_music" Title="{DynamicResource settings.Spotify.Title}" Description="{Binding SpotifyStatusText}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:M3Button Variant="Filled" Icon="login" Content="{DynamicResource settings.Spotify.Connect}"
                                                 Command="{Binding ConnectSpotifyCommand}" IsEnabled="{Binding CanConnectSpotify}"
                                                 Visibility="{Binding IsSpotifyConnected, Converter={conv:BoolToVisibility}, ConverterParameter=Invert}" />
                                    <ui:M3Button Variant="Outlined" Icon="logout" Content="{DynamicResource settings.Spotify.Disconnect}"
                                                 Command="{Binding DisconnectSpotifyCommand}"
                                                 Visibility="{Binding IsSpotifyConnected, Converter={conv:BoolToVisibility}}" />
                                </StackPanel>
                            </local:SettingRow>
                            <TextBlock Style="{DynamicResource Text.BodyS}" Text="{DynamicResource settings.Spotify.BrowserHint}" TextWrapping="Wrap" Margin="48,0,0,4"
                                       Visibility="{Binding IsSpotifyBusy, Converter={conv:BoolToVisibility}}" />
                            <TextBlock Style="{DynamicResource Text.BodyS}" Foreground="{DynamicResource Brush.Error}" Text="{Binding SpotifyErrorText}" TextWrapping="Wrap" Margin="48,0,0,4"
                                       Visibility="{Binding SpotifyErrorText, Converter={conv:NullToVisibility}}" />
                            <TextBox Margin="0,8,0,0" IsEnabled="{Binding CanEditSpotifyClient}" Style="{DynamicResource TextField}" ui:Field.Icon="key"
                                     ui:Field.Placeholder="{DynamicResource settings.Spotify.ClientId}"
                                     Text="{Binding SpotifyClientId, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- exact redirect URI to register -->
                            <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="16" Padding="12,8" Margin="0,8,0,0">
                                <DockPanel>
                                    <ui:M3Button DockPanel.Dock="Right" Variant="Tonal" Size="S" Icon="content_copy" Margin="8,0,0,0"
                                                 Content="{DynamicResource settings.Spotify.Copy}" Command="{Binding CopySpotifyRedirectCommand}" />
                                    <ui:Icon Glyph="link" Size="20" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Primary}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{DynamicResource Text.LabelS}" Text="{DynamicResource settings.Spotify.RedirectLabel}" />
                                        <TextBox Style="{x:Null}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                                 FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource Brush.OnSurface}"
                                                 Text="{Binding SpotifyRedirectUri, Mode=OneWay}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Button Style="{StaticResource Tappable}" Command="{Binding ToggleSpotifyHelpCommand}" Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <DockPanel Background="Transparent" Margin="0,6">
                                    <ui:Icon DockPanel.Dock="Right" Glyph="expand_more" Size="20" Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                                    <ui:Icon Glyph="help" Size="20" Margin="0,0,10,0" Foreground="{DynamicResource Brush.Primary}" />
                                    <TextBlock Style="{DynamicResource Text.Label}" Text="{DynamicResource settings.Spotify.HelpTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                            <StackPanel Visibility="{Binding SpotifyHelpOpen, Converter={conv:BoolToVisibility}}" Margin="30,4,0,0">
                                <TextBlock Style="{DynamicResource Text.BodyS}" TextWrapping="Wrap" Margin="0,2" Text="{DynamicResource settings.Spotify.Step1}" />
                                <TextBlock Style="{DynamicResource Text.BodyS}" TextWrapping="Wrap" Margin="0,2" Text="{DynamicResource settings.Spotify.Step2}" />
                                <TextBlock Style="{DynamicResource Text.BodyS}" TextWrapping="Wrap" Margin="0,2" Text="{DynamicResource settings.Spotify.Step3}" />
                                <TextBlock Style="{DynamicResource Text.BodyS}" TextWrapping="Wrap" Margin="0,2" Text="{DynamicResource settings.Spotify.Step4}" />
                                <TextBlock Style="{DynamicResource Text.BodyS}" TextWrapping="Wrap" Margin="0,2" Text="{DynamicResource settings.Spotify.Step5}" />
                                <TextBlock Style="{DynamicResource Text.BodyS}" TextWrapping="Wrap" Margin="0,6,0,2" Text="{DynamicResource settings.Spotify.Notes}" />
                                <ui:M3Button Variant="Tonal" Icon="open_in_new" HorizontalAlignment="Left" Margin="0,8,0,0"
                                             Content="{DynamicResource settings.Spotify.OpenDashboard}" Command="{Binding OpenSpotifyDashboardCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{DynamicResource Text.Overline}" Text="{DynamicResource settings.General.Data}" Margin="4,16,0,8" />
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <local:SettingRow Icon="folder_open" Title="{DynamicResource settings.General.DataFolder}" Description="{Binding DataFolder}">
                                <ui:M3Button Variant="Tonal" Size="S" Icon="open_in_new" Content="{DynamicResource settings.General.Open}" Command="{Binding OpenDataFolderCommand}" />
                            </local:SettingRow>
                            <local:SettingRow Icon="description" Title="{DynamicResource settings.General.Logs}" Description="{DynamicResource settings.General.LogsDesc}">
                                <ui:M3Button Variant="Tonal" Size="S" Icon="open_in_new" Content="{DynamicResource settings.General.Open}" Command="{Binding OpenLogsCommand}" />
                            </local:SettingRow>
                        </StackPanel>
                    </Border>
                    <!-- O aplikacji -->
                    <TextBlock Style="{DynamicResource Text.Overline}" Text="{DynamicResource settings.About.Header}" Margin="4,16,0,8" />
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="16" Margin="0,0,14,0" VerticalAlignment="Top"
                                        Background="{DynamicResource Brush.PrimaryContainer}">
                                    <ui:Icon Glyph="vertical_align_top" Size="26" Filled="True" Foreground="{DynamicResource Brush.PrimarySoft}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{DynamicResource Text.TitleL}" Text="NotchHub" VerticalAlignment="Center" />
                                        <Border CornerRadius="8" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center" Background="{DynamicResource Brush.Surface3}">
                                            <TextBlock Style="{DynamicResource Text.LabelS}" Text="{Binding VersionLabel}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{DynamicResource Text.BodyS}" Text="{DynamicResource settings.General.About}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <ui:Icon Glyph="balance" Size="16" Foreground="{DynamicResource Brush.OnSurfaceVariant}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Style="{DynamicResource Text.BodyS}" Text="{DynamicResource settings.About.License}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,14,0,0">
                                <ui:M3Button Variant="Tonal" Size="S" Icon="code" Margin="0,0,8,8" Content="{DynamicResource settings.About.GitHub}" Command="{Binding OpenRepoCommand}" />
                                <ui:M3Button Variant="Tonal" Size="S" Icon="language" Margin="0,0,8,8" Content="{DynamicResource settings.About.Website}" Command="{Binding OpenWebsiteCommand}" />
                                <ui:M3Button Variant="Outlined" Size="S" Icon="description" Margin="0,0,8,8" Content="{DynamicResource settings.About.Logs}" Command="{Binding OpenLogsCommand}" />
                                <ui:M3Button Variant="Outlined" Size="S" Icon="folder_open" Margin="0,0,8,8" Content="{DynamicResource settings.About.Data}" Command="{Binding OpenDataFolderCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Wsparcie: Buy Me a Coffee -->
                    <Border Style="{DynamicResource CardFlat}" Margin="0,12,0,0" Padding="18,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="22" Margin="0,0,14,0" VerticalAlignment="Top" Background="#33FFDD00">
                                <ui:Icon Glyph="volunteer_activism" Size="24" Filled="True" Foreground="#FFFFDD00" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{DynamicResource Text.Body}" TextWrapping="Wrap" Text="{DynamicResource settings.About.Support}" />
                                <Button HorizontalAlignment="Left" Margin="0,12,0,0" Cursor="Hand" Command="{Binding OpenBuyMeACoffeeCommand}"
                                        ToolTip="buymeacoffee.com/gimpostin" AutomationProperties.Name="Buy me a coffee">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Pill" Background="#FFFFDD00" CornerRadius="21" Height="42" Padding="16,0,20,0"
                                                    BorderThickness="2" BorderBrush="Transparent" RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:Icon Glyph="local_cafe" Size="22" Filled="True" Foreground="#FF0D0C22" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{DynamicResource settings.About.Bmc}" Foreground="#FF0D0C22" FontSize="15" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Pill" Property="Background" Value="#FFFFE433" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Pill" Property="Background" Value="#FFF2D200" />
                                                    <Setter TargetName="Pill" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value></Setter>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Brush.OnSurface}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
