<Window x:Class="NotchHub.App.Shell.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:NotchHub.UI.Controls;assembly=NotchHub.UI"
        xmlns:local="clr-namespace:NotchHub.App.Shell"
        Title="NotchHub" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Width="1000" Height="660"
        UseLayoutRounding="False" FontFamily="{DynamicResource Font.Sans}" Foreground="{DynamicResource Brush.OnSurface}">
    <Window.Resources>
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="17" />
                            <Border x:Name="State" Background="{DynamicResource Brush.StateHover}" CornerRadius="17" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="State" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- invisible hover zone around the collapsed notch (#01 alpha keeps it hit-testable on a layered window) -->
        <Border x:Name="HoverZone" Background="#01000000" HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="260" Height="26" CornerRadius="0,0,14,14" />

        <local:NotchShape x:Name="Notch" HorizontalAlignment="Center" VerticalAlignment="Top"
                          Fill="{DynamicResource Brush.Panel}" GlowBrush="{DynamicResource Brush.Primary}" RenderTransformOrigin="0.5,0">
            <local:NotchShape.RenderTransform>
                <ScaleTransform x:Name="NotchScale" />
            </local:NotchShape.RenderTransform>
            <Grid x:Name="Stage">
                <local:MeasureHost x:Name="LiveLayer" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" />
                <local:MeasureHost x:Name="PeekHost" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" />
                <local:MeasureHost x:Name="HudHost" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" />

                <Grid x:Name="ExpandedLayer" Width="820" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Visibility="Collapsed" Opacity="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- header -->
                    <Grid x:Name="Header">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PhoneChip" Style="{StaticResource PlainButton}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="14,4,0,0" Height="30" Background="{DynamicResource Brush.Surface2}" Padding="10,0,10,0"
                                Visibility="Collapsed" local:Tactile.Squish="0.06">
                            <StackPanel Orientation="Horizontal">
                                <ui:Icon Glyph="smartphone" Size="16" Foreground="{DynamicResource Brush.OnSurfaceVariant}" VerticalAlignment="Center" />
                                <TextBlock x:Name="PhoneBattery" Margin="5,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.OnSurface}" />
                                <ui:Icon x:Name="PhoneBolt" Glyph="bolt" Size="14" Filled="True" Margin="1,0,0,0" VerticalAlignment="Center"
                                         Foreground="{DynamicResource Brush.Primary}" Visibility="Collapsed" />
                                <Border x:Name="PhoneBadge" Margin="7,0,0,0" MinWidth="18" Height="18" CornerRadius="9" Padding="5,0"
                                        Background="{DynamicResource Brush.Primary}" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="PhoneBadgeText" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Brush.OnPrimary}" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <Grid x:Name="TabStrip" Grid.Column="1" VerticalAlignment="Center" Margin="0,4,0,0" Height="32">
                            <local:TabPill x:Name="TabIndicator" Fill="{DynamicResource Brush.SecondaryContainer}" />
                            <StackPanel x:Name="TabButtons" Orientation="Horizontal" />
                        </Grid>

                        <Button x:Name="GearButton" Grid.Column="2" Style="{StaticResource PlainButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="0,8,12,0" Width="34" Height="34" local:Tactile.Squish="0.1">
                            <ui:Icon x:Name="GearIcon" Glyph="settings" Size="20" Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                        </Button>
                    </Grid>

                    <Border x:Name="TabBody" Grid.Row="1" Padding="14,4,14,14">
                        <Grid x:Name="TabStage" ClipToBounds="True" VerticalAlignment="Top" />
                    </Border>
                </Grid>
            </Grid>
        </local:NotchShape>
    </Grid>
</Window>
