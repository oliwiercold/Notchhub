<UserControl x:Class="NotchHub.Features.Compact.LiveActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:NotchHub.UI.Controls;assembly=NotchHub.UI"
             xmlns:conv="clr-namespace:NotchHub.UI.Converters;assembly=NotchHub.UI"
             Height="34" MinWidth="300" MaxWidth="560" HorizontalAlignment="Center"
             Foreground="{DynamicResource Brush.OnSurface}">
    <!-- Width is content driven: media only = 300, meeting bar widens the notch up to 560 (the shell animates to DesiredSize). -->
    <Grid Margin="12,0,16,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- album art 22 px, radius 6 -->
        <Grid Width="22" Height="22" VerticalAlignment="Center" ToolTip="{Binding Title}"
              Visibility="{Binding ShowMedia, Converter={conv:BoolToVisibility}}">
            <Border CornerRadius="6" Background="{DynamicResource Brush.PrimarySoft}">
                <ui:Icon Glyph="music_note" Size="14" Foreground="{DynamicResource Brush.OnPrimarySoft}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border CornerRadius="6" Visibility="{Binding Thumbnail, Converter={conv:NullToVisibility}}">
                <Border.Background>
                    <ImageBrush Stretch="UniformToFill"
                                ImageSource="{Binding Thumbnail, Converter={conv:BytesToImage}, ConverterParameter=44}" />
                </Border.Background>
            </Border>
        </Grid>

        <!-- meeting only: calendar icon tinted with the event colour -->
        <Border Width="22" Height="22" CornerRadius="11" VerticalAlignment="Center" Background="{DynamicResource Brush.PrimarySoft}"
                Visibility="{Binding ShowMeetingIcon, Converter={conv:BoolToVisibility}}">
            <ui:Icon Glyph="event" Size="14" Filled="True"
                     Foreground="{Binding MeetingBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- meeting bar text -->
        <Grid x:Name="MeetingPanel" Grid.Column="1" Margin="10,0" HorizontalAlignment="Center" VerticalAlignment="Stretch"
              ToolTip="{Binding MeetingTooltip}" Visibility="{Binding ShowMeeting, Converter={conv:BoolToVisibility}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="{Binding MeetingBrush}" VerticalAlignment="Center" Margin="0,1,7,0" />
                <TextBlock VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding MeetingWhen, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" />
                    <Run Text=" • " Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                    <Run Text="{Binding MeetingTitle, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <!-- subtle progress of the ongoing event -->
            <Grid Height="2" VerticalAlignment="Bottom" Margin="14,0,0,5"
                  Visibility="{Binding IsOngoing, Converter={conv:BoolToVisibility}}">
                <Border CornerRadius="1" Background="{DynamicResource Brush.OutlineVariant}" Opacity="0.6" />
                <Border CornerRadius="1" Background="{Binding MeetingBrush}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding MeetingProgress}" />
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Grid>

        <!-- 4-bar equalizer -->
        <StackPanel x:Name="Bars" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="16"
                    Visibility="{Binding ShowMedia, Converter={conv:BoolToVisibility}}">
            <Border Width="3" CornerRadius="1.5" Margin="0,0,2.5,0" Background="{DynamicResource Brush.Primary}" />
            <Border Width="3" CornerRadius="1.5" Margin="0,0,2.5,0" Background="{DynamicResource Brush.Primary}" />
            <Border Width="3" CornerRadius="1.5" Margin="0,0,2.5,0" Background="{DynamicResource Brush.Primary}" />
            <Border Width="3" CornerRadius="1.5" Background="{DynamicResource Brush.Primary}" />
        </StackPanel>
    </Grid>
</UserControl>
