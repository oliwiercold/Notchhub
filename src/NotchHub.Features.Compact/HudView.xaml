<UserControl x:Class="NotchHub.Features.Compact.HudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:NotchHub.UI.Controls;assembly=NotchHub.UI"
             xmlns:conv="clr-namespace:NotchHub.UI.Converters;assembly=NotchHub.UI"
             xmlns:local="clr-namespace:NotchHub.Features.Compact"
             Width="360" Foreground="{DynamicResource Brush.OnSurface}">
    <Grid x:Name="Body" RenderTransformOrigin="0.5,0">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ContentScale" />
                <TranslateTransform x:Name="ContentShift" />
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- ───────── volume / brightness ───────── -->
        <Grid Margin="18,8,16,8" MinHeight="40"
              Visibility="{Binding Kind, Converter={conv:EnumEquals}, ConverterParameter=Volume}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <ui:Icon Glyph="{Binding LevelGlyph}" Size="22" Filled="True" VerticalAlignment="Center" />
            <ui:M3Slider Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center"
                         Minimum="0" Maximum="100" SmallChange="2" TrackHeight="28" ShowValue="False"
                         Value="{Binding Level}" DragStarted="OnDragStarted" DragCompleted="OnDragCompleted" />
            <TextBlock Grid.Column="2" Style="{DynamicResource Text.Label}" Text="{Binding LevelText}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
        <Grid Margin="18,8,16,8" MinHeight="40"
              Visibility="{Binding Kind, Converter={conv:EnumEquals}, ConverterParameter=Brightness}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <ui:Icon Glyph="{Binding LevelGlyph}" Size="22" Filled="True" VerticalAlignment="Center" />
            <ui:M3Slider Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center"
                         Minimum="0" Maximum="100" SmallChange="2" TrackHeight="28" ShowValue="False"
                         Value="{Binding Level}" DragStarted="OnDragStarted" DragCompleted="OnDragCompleted" />
            <TextBlock Grid.Column="2" Style="{DynamicResource Text.Label}" Text="{Binding LevelText}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <!-- ───────── phone notification ───────── -->
        <StackPanel Visibility="{Binding Kind, Converter={conv:EnumEquals}, ConverterParameter=PhoneNotification}">
        <Border Background="Transparent" Cursor="Hand" Padding="16,12" local:Press.Squish="0.03">
            <Border.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding OpenPhoneCommand}" />
            </Border.InputBindings>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <ui:Avatar Size="36" VerticalAlignment="Top" Margin="0,2,0,0" Text="{Binding NotificationApp}"
                           Image="{Binding NotificationIcon, Converter={conv:BytesToImage}, ConverterParameter=72}" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource Text.LabelS}" Text="{Binding NotificationApp}" />
                        <TextBlock Style="{DynamicResource Text.LabelS}" Text=" · " />
                        <TextBlock Style="{DynamicResource Text.LabelS}" Text="{Binding NotificationTime, Converter={conv:RelativeTime}}" />
                    </StackPanel>
                    <TextBlock Style="{DynamicResource Text.Title}" Text="{Binding NotificationTitle}" TextTrimming="CharacterEllipsis"
                               Margin="0,1,0,0" />
                    <TextBlock Style="{DynamicResource Text.BodyS}" Text="{Binding NotificationText}" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,1,0,0"
                               Visibility="{Binding NotificationText, Converter={conv:NullToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>
        <!-- one-time code: outside the clickable card so copying does not open the phone tab -->
        <ui:M3Button Variant="Tonal" Size="S" Margin="64,-4,16,12" HorizontalAlignment="Left"
                     Icon="{Binding OtpIcon}" Content="{Binding OtpButtonText}" Command="{Binding CopyOtpCommand}"
                     Visibility="{Binding OtpCode, Converter={conv:NullToVisibility}}" />
        </StackPanel>

        <!-- ───────── phone charging ───────── -->
        <Grid Margin="14,10,18,10" MinHeight="40"
              Visibility="{Binding Kind, Converter={conv:EnumEquals}, ConverterParameter=PhoneCharging}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="20">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Brush.SecondaryContainer}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Success}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ui:Icon Glyph="{Binding ChargeGlyph}" Size="22" Filled="True" RenderTransformOrigin="0.5,0.5"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:Icon.RenderTransform>
                        <ScaleTransform x:Name="BoltScale" />
                    </ui:Icon.RenderTransform>
                    <ui:Icon.Style>
                        <Style TargetType="ui:Icon">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSecondaryContainer}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnSuccess}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Icon.Style>
                </ui:Icon>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock Style="{DynamicResource Text.Title}" Text="{Binding ChargeTitle}" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{DynamicResource Text.LabelS}" Text="{DynamicResource compact.phone}"
                           Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{DynamicResource Text.Title}" Text="{Binding ChargePercentText}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <!-- battery: body + cap, the fill grows to the percentage -->
                <Grid Width="46" Height="22" VerticalAlignment="Center">
                    <Border Width="42" HorizontalAlignment="Left" CornerRadius="6" BorderThickness="2"
                            BorderBrush="{DynamicResource Brush.OnSurfaceVariant}" Padding="2">
                        <Border CornerRadius="3" HorizontalAlignment="Left" RenderTransformOrigin="0,0.5" Width="34">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ChargeFillScale" ScaleX="1" />
                            </Border.RenderTransform>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Brush.OnSurface}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBatteryLow}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Error}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Border>
                    <Border Width="3" Height="8" CornerRadius="0,2,2,0" HorizontalAlignment="Right"
                            Background="{DynamicResource Brush.OnSurfaceVariant}" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- ───────── phone call ───────── -->
        <Grid Margin="14,10,14,10" MinHeight="44"
              Visibility="{Binding Kind, Converter={conv:EnumEquals}, ConverterParameter=PhoneCall}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="44" Height="44">
                <!-- pulsing ring while ringing -->
                <Ellipse Stroke="{DynamicResource Brush.Success}" StrokeThickness="2" Opacity="0" x:Name="CallRing"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="CallRingScale" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <ui:Avatar Size="40" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding CallName}"
                           Image="{Binding CallPhoto, Converter={conv:BytesToImage}, ConverterParameter=80}" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ui:Icon Glyph="{Binding CallGlyph}" Size="13" Filled="True" VerticalAlignment="Center" Margin="0,0,4,0">
                        <ui:Icon.Style>
                            <Style TargetType="ui:Icon">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CallState}" Value="Missed">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CallState}" Value="Ended">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Icon.Style>
                    </ui:Icon>
                    <TextBlock Style="{DynamicResource Text.LabelS}" Text="{Binding CallStatusText}" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                </StackPanel>
                <TextBlock Style="{DynamicResource Text.Title}" Text="{Binding CallName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{DynamicResource Text.LabelS}" Text="{Binding CallDetail}" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                           Visibility="{Binding CallDetail, Converter={conv:NullToVisibility}}" />
            </StackPanel>
            <ui:M3Button Grid.Column="2" Variant="Tonal" Size="S" VerticalAlignment="Center"
                         Icon="{Binding MuteIcon}" Content="{Binding MuteText}" Command="{Binding MuteRingerCommand}"
                         Visibility="{Binding IsRinging, Converter={conv:BoolToVisibility}}" />
        </Grid>

        <!-- ───────── pair request ───────── -->
        <Grid Margin="16,12,14,12" Visibility="{Binding Kind, Converter={conv:EnumEquals}, ConverterParameter=PhonePairRequest}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Brush.PrimarySoft}">
                <ui:Icon Glyph="smartphone" Size="20" Foreground="{DynamicResource Brush.OnPrimarySoft}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{DynamicResource Text.LabelS}" Text="{DynamicResource compact.pairRequest}" />
                <TextBlock Style="{DynamicResource Text.Title}" Text="{Binding PairDeviceName}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{DynamicResource Text.LabelS}" Text="{DynamicResource compact.pairKey}" />
                    <TextBlock Style="{DynamicResource Text.Title}" Text="{Binding PairKey}" FontFamily="Consolas"
                               Foreground="{DynamicResource Brush.Primary}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:M3Button Variant="Text" Size="S" Content="{DynamicResource compact.reject}" Command="{Binding RejectPairCommand}" />
                    <ui:M3Button Variant="Filled" Size="S" Icon="check" Margin="6,0,0,0" Content="{DynamicResource compact.accept}"
                                 Command="{Binding AcceptPairCommand}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ───────── timer finished ───────── -->
        <Grid Margin="14,10,14,10" Visibility="{Binding Kind, Converter={conv:EnumEquals}, ConverterParameter=TimerFinished}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Brush.TertiaryContainer}">
                <ui:Icon x:Name="TimerIcon" Glyph="timer" Size="22" Filled="True" Foreground="{DynamicResource Brush.OnTertiaryContainer}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <ui:Icon.RenderTransform>
                        <RotateTransform x:Name="TimerRotate" />
                    </ui:Icon.RenderTransform>
                </ui:Icon>
            </Border>
            <TextBlock Grid.Column="1" Style="{DynamicResource Text.TitleL}" Text="{DynamicResource compact.timeUp}"
                       Margin="12,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:M3Button Variant="Tonal" Size="S" Content="{DynamicResource compact.plusMinute}" Command="{Binding AddMinuteCommand}" />
                <ui:M3Button Variant="Filled" Size="S" Margin="6,0,0,0" Icon="stop" Content="{DynamicResource compact.stop}"
                             Command="{Binding StopTimerCommand}" />
            </StackPanel>
        </Grid>

        <!-- ───────── info ───────── -->
        <StackPanel Orientation="Horizontal" Margin="18,10" MinHeight="36" HorizontalAlignment="Center"
                    Visibility="{Binding Kind, Converter={conv:EnumEquals}, ConverterParameter=Info}">
            <ui:Icon Glyph="info" Size="20" Foreground="{DynamicResource Brush.Primary}" VerticalAlignment="Center" />
            <TextBlock Style="{DynamicResource Text.Body}" Text="{Binding InfoText}" Margin="10,0,0,0" MaxWidth="290"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
