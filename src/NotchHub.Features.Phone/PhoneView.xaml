<UserControl x:Class="NotchHub.Features.Phone.PhoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:NotchHub.UI.Controls;assembly=NotchHub.UI"
             xmlns:conv="clr-namespace:NotchHub.UI.Converters;assembly=NotchHub.UI"
             xmlns:local="clr-namespace:NotchHub.Features.Phone"
             x:Name="Root" Width="792" Foreground="{DynamicResource Brush.OnSurface}">
    <UserControl.Resources>
        <!-- Small numbered onboarding step -->
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource Brush.PrimaryContainer}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.OnPrimaryContainer}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="IconCircle" TargetType="Border">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
        </Style>
        <Style x:Key="BatteryRing" TargetType="ui:WavyRing">
            <Setter Property="ActiveBrush" Value="{DynamicResource Brush.Success}" />
            <Setter Property="TrackBrush" Value="{DynamicResource Brush.OutlineVariant}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding BatteryTone}" Value="Warning">
                    <Setter Property="ActiveBrush" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BatteryTone}" Value="Low">
                    <Setter Property="ActiveBrush" Value="{DynamicResource Brush.Error}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCharging}" Value="False">
                    <Setter Property="IsWavy" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NotificationRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="12,10" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ===================== DISABLED ===================== -->
        <Border Style="{DynamicResource Card}" Padding="28" MinHeight="300"
                Visibility="{Binding Mode, Converter={conv:EnumEquals}, ConverterParameter=Disabled}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                <Border Style="{StaticResource IconCircle}" Width="72" Height="72" CornerRadius="36">
                    <ui:Icon Glyph="phonelink_off" Size="34" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                </Border>
                <TextBlock Style="{DynamicResource Text.TitleL}" Margin="0,16,0,0" HorizontalAlignment="Center"
                           Text="{DynamicResource phone.disabledTitle}" />
                <TextBlock Style="{DynamicResource Text.BodyS}" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"
                           Text="{DynamicResource phone.disabledBody}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <ui:M3Button Content="{DynamicResource phone.enable}" Icon="power_settings_new" Variant="Filled" Size="M"
                                 Command="{Binding EnableCommand}" />
                    <ui:M3Button Content="{DynamicResource common.settings}" Icon="settings" Variant="Text" Size="M" Margin="8,0,0,0"
                                 Command="{Binding OpenSettingsCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===================== SETUP (no device / discovered) ===================== -->
        <Grid Visibility="{Binding Mode, Converter={conv:EnumEquals}, ConverterParameter=Setup}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Style="{DynamicResource Card}" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconCircle}" Background="{DynamicResource Brush.PrimaryContainer}">
                            <ui:Icon Glyph="phonelink_setup" Size="24" Filled="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Foreground="{DynamicResource Brush.OnPrimaryContainer}" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource Text.TitleL}" Text="{DynamicResource phone.setupTitle}" />
                            <TextBlock Style="{DynamicResource Text.BodyS}" Text="{DynamicResource phone.setupSubtitle}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource StepNumber}">
                            <TextBlock Style="{DynamicResource Text.Label}" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,4,0,14">
                            <TextBlock Style="{DynamicResource Text.Title}" Text="{DynamicResource phone.step1Title}" />
                            <TextBlock Style="{DynamicResource Text.BodyS}" TextWrapping="Wrap" Text="{DynamicResource phone.step1Body}" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource StepNumber}">
                            <TextBlock Style="{DynamicResource Text.Label}" Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,4,0,14">
                            <TextBlock Style="{DynamicResource Text.Title}" Text="{DynamicResource phone.step2Title}" />
                            <TextBlock Style="{DynamicResource Text.BodyS}" TextWrapping="Wrap" Text="{DynamicResource phone.step2Body}" />
                        </StackPanel>

                        <Border Grid.Row="2" Style="{StaticResource StepNumber}">
                            <TextBlock Style="{DynamicResource Text.Label}" Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,4,0,14">
                            <TextBlock Style="{DynamicResource Text.Title}" Text="{DynamicResource phone.step3Title}" />
                            <TextBlock Style="{DynamicResource Text.BodyS}" TextWrapping="Wrap" Text="{DynamicResource phone.step3Body}" />
                        </StackPanel>

                        <Border Grid.Row="3" Style="{StaticResource StepNumber}">
                            <TextBlock Style="{DynamicResource Text.Label}" Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="12,4,0,0">
                            <TextBlock Style="{DynamicResource Text.Title}" Text="{DynamicResource phone.step4Title}" />
                            <TextBlock Style="{DynamicResource Text.BodyS}" TextWrapping="Wrap">
                                <Run Text="{DynamicResource phone.step4BodyA}" /><Run Text="{Binding LocalName, Mode=OneWay}" FontWeight="SemiBold"
                                     Foreground="{DynamicResource Brush.OnSurface}" /><Run Text="{DynamicResource phone.step4BodyB}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="16">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="4,0,0,10">
                        <ui:IconButton DockPanel.Dock="Right" Icon="refresh" Variant="Tonal" Size="36"
                                       Command="{Binding RefreshDevicesCommand}" ToolTip="{DynamicResource phone.refresh}" />
                        <TextBlock Style="{DynamicResource Text.Overline}" Text="{DynamicResource phone.nearby}" VerticalAlignment="Center" />
                    </DockPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,4">
                        <ui:LoadingIndicator Size="28" IsActive="True" />
                        <TextBlock Style="{DynamicResource Text.LabelS}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="{DynamicResource phone.searching}" />
                    </StackPanel>

                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,24"
                                    Visibility="{Binding HasDiscovered, Converter={conv:BoolToVisibility}, ConverterParameter=Invert}">
                            <ui:Icon Glyph="devices_other" Size="36" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.OnSurfaceMuted}" />
                            <TextBlock Style="{DynamicResource Text.BodyS}" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                       Text="{DynamicResource phone.noDevices}" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                            <ItemsControl ItemsSource="{Binding Discovered}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:DeviceItem}">
                                        <Border CornerRadius="18" Background="{DynamicResource Brush.Surface2}" Padding="10" Margin="0,0,0,6"
                                                local:Reveal.IsOpen="True" local:Reveal.AnimateOnLoad="True">
                                            <DockPanel>
                                                <ui:M3Button DockPanel.Dock="Right" Content="{DynamicResource phone.pair}" Icon="link" Variant="Tonal" Size="S"
                                                             VerticalAlignment="Center" Command="{Binding PairCommand}"
                                                             IsEnabled="{Binding IsBusy, Converter={conv:InverseBool}}" />
                                                <Border Style="{StaticResource IconCircle}" Width="36" Height="36" CornerRadius="18">
                                                    <ui:Icon Glyph="{Binding Icon}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Margin="10,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Style="{DynamicResource Text.Title}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{DynamicResource Text.LabelS}" Text="{Binding Address}" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding Address, Converter={conv:NullToVisibility}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===================== PAIRING (outgoing / incoming) ===================== -->
        <Border Style="{DynamicResource Card}" Padding="28" MinHeight="300"
                Visibility="{Binding IsPairing, Converter={conv:BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
                <Grid HorizontalAlignment="Center">
                    <ui:LoadingIndicator Size="80" IsActive="{Binding Mode, Converter={conv:EnumEquals}, ConverterParameter=PairOutgoing}"
                                         Visibility="{Binding Mode, Converter={conv:EnumEquals}, ConverterParameter=PairOutgoing}" />
                    <Border Style="{StaticResource IconCircle}" Width="64" Height="64" CornerRadius="32"
                            Background="{DynamicResource Brush.PrimaryContainer}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:Icon Glyph="{Binding DeviceIcon}" Size="30" Filled="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Brush.OnPrimaryContainer}" />
                    </Border>
                </Grid>
                <TextBlock Style="{DynamicResource Text.TitleL}" Margin="0,16,0,0" HorizontalAlignment="Center"
                           Text="{DynamicResource phone.waitingTitle}"
                           Visibility="{Binding Mode, Converter={conv:EnumEquals}, ConverterParameter=PairOutgoing}" />
                <TextBlock Style="{DynamicResource Text.TitleL}" Margin="0,16,0,0" HorizontalAlignment="Center"
                           Text="{DynamicResource phone.incomingTitle}"
                           Visibility="{Binding Mode, Converter={conv:EnumEquals}, ConverterParameter=PairIncoming}" />
                <TextBlock Style="{DynamicResource Text.Title}" Margin="0,2,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Primary}" Text="{Binding DeviceName}" />

                <Border Style="{DynamicResource CardFlat}" Margin="0,18,0,0" Padding="16,12" HorizontalAlignment="Center" MinWidth="240"
                        Visibility="{Binding VerificationKey, Converter={conv:NullToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.Overline}" HorizontalAlignment="Center" Text="{DynamicResource phone.keyLabel}" />
                        <TextBlock Style="{DynamicResource Text.Headline}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                   FontFamily="Consolas" Text="{Binding VerificationKey}" Foreground="{DynamicResource Brush.Primary}" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{DynamicResource Text.BodyS}" Margin="0,14,0,0" TextAlignment="Center" TextWrapping="Wrap"
                           Text="{DynamicResource phone.waitingBody}"
                           Visibility="{Binding Mode, Converter={conv:EnumEquals}, ConverterParameter=PairOutgoing}" />
                <TextBlock Style="{DynamicResource Text.BodyS}" Margin="0,14,0,0" TextAlignment="Center" TextWrapping="Wrap"
                           Text="{DynamicResource phone.incomingBody}"
                           Visibility="{Binding Mode, Converter={conv:EnumEquals}, ConverterParameter=PairIncoming}" />

                <ui:M3Button Margin="0,18,0,0" HorizontalAlignment="Center" Content="{DynamicResource common.cancel}" Icon="close"
                             Variant="Outlined" Size="M" Command="{Binding CancelPairCommand}"
                             Visibility="{Binding Mode, Converter={conv:EnumEquals}, ConverterParameter=PairOutgoing}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0"
                            Visibility="{Binding Mode, Converter={conv:EnumEquals}, ConverterParameter=PairIncoming}">
                    <ui:M3Button Content="{DynamicResource phone.reject}" Icon="close" Variant="Outlined" Size="M"
                                 Command="{Binding RejectPairCommand}" />
                    <ui:M3Button Content="{DynamicResource phone.accept}" Icon="check" Variant="Filled" Size="M" Margin="10,0,0,0"
                                 Command="{Binding AcceptPairCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===================== PAIRED (online / offline) ===================== -->
        <Grid Visibility="{Binding IsPaired, Converter={conv:BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Device card -->
            <Border Style="{DynamicResource Card}" Padding="16">
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                    <Setter Property="Opacity" Value="0.62" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <DockPanel>
                            <ui:IconButton DockPanel.Dock="Right" Icon="more_vert" Variant="Standard" Size="36" VerticalAlignment="Top"
                                           Command="{Binding ToggleOverflowCommand}" IsSelected="{Binding IsOverflowOpen}"
                                           ToolTip="{DynamicResource phone.more}" />
                            <Border Style="{StaticResource IconCircle}">
                                <ui:Icon Glyph="{Binding DeviceIcon}" Size="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,4,0" VerticalAlignment="Center">
                                <TextBlock Style="{DynamicResource Text.Title}" Text="{Binding DeviceName}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.OnSurfaceMuted}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Style="{DynamicResource Text.LabelS}" Text="{Binding StatusText}" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <!-- overflow (inline, no popup) -->
                        <Border local:Reveal.IsOpen="{Binding IsOverflowOpen}" Visibility="Collapsed">
                            <ui:M3Button Margin="0,10,0,0" HorizontalAlignment="Stretch" Content="{DynamicResource phone.unpair}" Icon="link_off"
                                         Variant="Tonal" Size="S" Command="{Binding UnpairCommand}" />
                        </Border>

                        <!-- battery -->
                        <Grid Width="128" Height="128" Margin="0,16,0,0" HorizontalAlignment="Center">
                            <ui:WavyRing Style="{StaticResource BatteryRing}" Value="{Binding BatteryValue}" Thickness="10" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasBattery, Converter={conv:BoolToVisibility}}">
                                <ui:Icon Glyph="bolt" Size="18" Filled="True" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Success}"
                                         Visibility="{Binding IsCharging, Converter={conv:BoolToVisibility}}" />
                                <TextBlock Style="{DynamicResource Text.Number}" HorizontalAlignment="Center" Text="{Binding BatteryText}" />
                                <TextBlock Style="{DynamicResource Text.LabelS}" HorizontalAlignment="Center" Text="{Binding BatteryCaption}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="96"
                                        Visibility="{Binding HasBattery, Converter={conv:BoolToVisibility}, ConverterParameter=Invert}">
                                <ui:Icon Glyph="battery_unknown" Size="30" HorizontalAlignment="Center"
                                         Foreground="{DynamicResource Brush.OnSurfaceMuted}" />
                                <TextBlock Style="{DynamicResource Text.LabelS}" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                           Text="{DynamicResource phone.batteryUnknown}" />
                            </StackPanel>
                        </Grid>

                        <!-- signal -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"
                                    Visibility="{Binding HasSignal, Converter={conv:BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding SignalBars}" Focusable="False" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:SignalBar}">
                                        <Border Width="4" Height="{Binding Height}" CornerRadius="2" Margin="1.5,0" VerticalAlignment="Bottom">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.OnSurface}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding On}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.OutlineVariant}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="8" Background="{DynamicResource Brush.SecondaryContainer}"
                                    Visibility="{Binding NetworkType, Converter={conv:NullToVisibility}}">
                                <TextBlock Style="{DynamicResource Text.Label}" Foreground="{DynamicResource Brush.OnSecondaryContainer}"
                                           Text="{Binding NetworkType}" />
                            </Border>
                        </StackPanel>

                        <!-- actions -->
                        <UniformGrid Columns="2" Margin="-3,16,-3,0" IsEnabled="{Binding IsConnected}">
                            <ui:M3Button Margin="3" HorizontalAlignment="Stretch" Content="{DynamicResource phone.ring}" Icon="ring_volume"
                                         Variant="Tonal" Size="S" Command="{Binding RingCommand}" local:Press.Squish="0.05" />
                            <ui:M3Button Margin="3" HorizontalAlignment="Stretch" Content="{DynamicResource phone.ping}" Icon="notifications_active"
                                         Variant="Tonal" Size="S" Command="{Binding PingCommand}" local:Press.Squish="0.05" />
                            <ui:M3Button Margin="3" HorizontalAlignment="Stretch" Content="{DynamicResource phone.sendClipboard}" Icon="content_paste_go"
                                         Variant="Tonal" Size="S" Command="{Binding SendClipboardCommand}" local:Press.Squish="0.05" />
                            <ui:M3Button Margin="3" HorizontalAlignment="Stretch" Content="{DynamicResource phone.refresh}" Icon="refresh"
                                         Variant="Tonal" Size="S" Command="{Binding RefreshDevicesCommand}" local:Press.Squish="0.05" />
                        </UniformGrid>
                        <Grid Height="20" Margin="0,8,0,0">
                            <TextBlock Style="{DynamicResource Text.LabelS}" HorizontalAlignment="Center" Text="{Binding Feedback}"
                                       Foreground="{DynamicResource Brush.Primary}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <DockPanel Grid.Column="2">
            <!-- Call status card (kdeconnect.telephony) -->
            <Border DockPanel.Dock="Top" Style="{DynamicResource Card}" Padding="14" Margin="0,0,0,12"
                    Visibility="{Binding HasCall, Converter={conv:BoolToVisibility}}">
                <DockPanel>
                    <ui:M3Button DockPanel.Dock="Right" VerticalAlignment="Center" Icon="volume_off" Size="M" Variant="Filled"
                                 Content="{DynamicResource phone.mute}" Command="{Binding MuteRingerCommand}" local:Press.Squish="0.05"
                                 Visibility="{Binding CanMute, Converter={conv:BoolToVisibility}}" />
                    <ui:M3Button DockPanel.Dock="Right" VerticalAlignment="Center" Icon="volume_off" Size="M" Variant="Tonal"
                                 Content="{DynamicResource phone.muted}" IsEnabled="False"
                                 Visibility="{Binding IsRingerMuted, Converter={conv:BoolToVisibility}}" />
                    <Grid Width="48" Height="48">
                        <ui:Avatar Size="48" Text="{Binding CallName}"
                                   Image="{Binding CallPhoto, Converter={conv:BytesToImage}, ConverterParameter=96}" />
                        <Border CornerRadius="24" Background="{DynamicResource Brush.PrimaryContainer}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CallHasName}" Value="False" />
                                                <Condition Binding="{Binding CallPhoto}" Value="{x:Null}" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:Icon Glyph="person" Size="26" Filled="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Foreground="{DynamicResource Brush.OnPrimaryContainer}" />
                        </Border>
                        <Border Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4"
                                BorderThickness="2" BorderBrush="{DynamicResource Brush.Surface1}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CallState}" Value="Missed">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Error}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:Icon Size="13" Filled="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Foreground="{DynamicResource Brush.OnPrimary}">
                                <ui:Icon.Style>
                                    <Style TargetType="ui:Icon">
                                        <Setter Property="Glyph" Value="phone_in_talk" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CallState}" Value="Ringing">
                                                <Setter Property="Glyph" Value="ring_volume" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CallState}" Value="Missed">
                                                <Setter Property="Glyph" Value="call_missed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Icon.Style>
                            </ui:Icon>
                        </Border>
                    </Grid>
                    <StackPanel Margin="14,0,8,0" VerticalAlignment="Center">
                        <TextBlock Style="{DynamicResource Text.LabelS}" Text="{Binding CallStatusText}" Foreground="{DynamicResource Brush.Primary}"
                                   Visibility="{Binding IsCallMissed, Converter={conv:BoolToVisibility}, ConverterParameter=Invert}" />
                        <TextBlock Style="{DynamicResource Text.LabelS}" Text="{Binding CallStatusText}" Foreground="{DynamicResource Brush.Error}"
                                   Visibility="{Binding IsCallMissed, Converter={conv:BoolToVisibility}}" />
                        <TextBlock Style="{DynamicResource Text.TitleL}" Text="{Binding CallName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{DynamicResource Text.BodyS}" Text="{Binding CallNumber}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding CallNumber, Converter={conv:NullToVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Notifications card -->
            <Border Style="{DynamicResource Card}" Padding="14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="6,0,0,10" MinHeight="32">
                        <ui:M3Button DockPanel.Dock="Right" Content="{DynamicResource phone.clearAll}" Icon="clear_all" Variant="Text" Size="S"
                                     Command="{Binding ClearAllCommand}"
                                     Visibility="{Binding HasClearable, Converter={conv:BoolToVisibility}}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource Text.TitleL}" Text="{DynamicResource phone.notifications}" />
                            <ui:Badge Content="{Binding NotificationCount}" Margin="8,0,0,0" VerticalAlignment="Center"
                                      Visibility="{Binding NotificationCount, Converter={conv:ZeroToCollapsed}}" />
                        </StackPanel>
                    </DockPanel>

                    <Grid MinHeight="300">
                        <!-- empty / offline states -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NotificationCount}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Style="{StaticResource IconCircle}" Width="64" Height="64" CornerRadius="32">
                                <ui:Icon Glyph="notifications_off" Size="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                            </Border>
                            <TextBlock Style="{DynamicResource Text.Title}" Margin="0,12,0,0" HorizontalAlignment="Center"
                                       Text="{DynamicResource phone.noNotifications}"
                                       Visibility="{Binding IsOffline, Converter={conv:BoolToVisibility}, ConverterParameter=Invert}" />
                            <TextBlock Style="{DynamicResource Text.Title}" Margin="0,12,0,0" HorizontalAlignment="Center"
                                       Text="{DynamicResource phone.offlineTitle}"
                                       Visibility="{Binding IsOffline, Converter={conv:BoolToVisibility}}" />
                            <TextBlock Style="{DynamicResource Text.BodyS}" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                       Text="{DynamicResource phone.offlineBody}"
                                       Visibility="{Binding IsOffline, Converter={conv:BoolToVisibility}}" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="{Binding NotificationsMaxHeight}" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Notifications}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:NotificationItem}">
                                        <Border Style="{StaticResource NotificationRow}"
                                                local:Reveal.IsOpen="{Binding IsRemoving, Converter={conv:InverseBool}}"
                                                local:Reveal.AnimateOnLoad="True"
                                                local:SwipeToDismiss.Command="{Binding DismissCommand}"
                                                local:SwipeToDismiss.TapCommand="{Binding ToggleCommand}"
                                                local:SwipeToDismiss.CanDismiss="{Binding CanDismiss}">
                                            <StackPanel>
                                                <!-- header (click to expand; drag sideways to dismiss) -->
                                                <Grid Background="Transparent" Cursor="Hand" local:SwipeToDismiss.TapArea="True">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="36" Height="36" VerticalAlignment="Top">
                                                        <ui:Avatar Text="{Binding AppName}" Size="36"
                                                                   Visibility="{Binding IconPng, Converter={conv:NullToVisibility}, ConverterParameter=Invert}" />
                                                        <Border CornerRadius="18" Background="{DynamicResource Brush.PrimaryContainer}"
                                                                Visibility="{Binding IconPng, Converter={conv:NullToVisibility}}">
                                                            <Image Width="22" Height="22" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                                                   Source="{Binding IconPng, Converter={conv:BytesToImage}, ConverterParameter=44}" />
                                                        </Border>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                                        <TextBlock Style="{DynamicResource Text.LabelS}" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding AppName, Mode=OneWay}" /><Run Text=" • " /><Run
                                                                 Text="{Binding Time, Mode=OneWay, Converter={conv:RelativeTime}}" />
                                                        </TextBlock>
                                                        <TextBlock Style="{DynamicResource Text.Title}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Style="{DynamicResource Text.BodyS}" Text="{Binding Text}" TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding IsExpanded, Converter={conv:BoolToVisibility}, ConverterParameter=Invert}" />
                                                        <!-- one-time code: one click copies it -->
                                                        <Grid HorizontalAlignment="Left" Margin="0,6,0,0"
                                                              Visibility="{Binding HasOtp, Converter={conv:BoolToVisibility}}">
                                                            <ui:M3Button Variant="Tonal" Size="S" Icon="content_copy" Command="{Binding CopyOtpCommand}"
                                                                         ToolTip="{DynamicResource phone.copyCode}" local:Press.Squish="0.05"
                                                                         Visibility="{Binding OtpCopied, Converter={conv:BoolToVisibility}, ConverterParameter=Invert}">
                                                                <TextBlock Text="{Binding OtpLabel}" FontFamily="Consolas" FontWeight="SemiBold" />
                                                            </ui:M3Button>
                                                            <ui:M3Button Variant="Filled" Size="S" Icon="check" Content="{DynamicResource phone.codeCopied}"
                                                                         Command="{Binding CopyOtpCommand}"
                                                                         Visibility="{Binding OtpCopied, Converter={conv:BoolToVisibility}}" />
                                                        </Grid>
                                                    </StackPanel>
                                                    <ui:Icon Grid.Column="2" Glyph="expand_more" Size="20" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource Brush.OnSurfaceVariant}" RenderTransformOrigin="0.5,0.5">
                                                        <ui:Icon.RenderTransform>
                                                            <RotateTransform />
                                                        </ui:Icon.RenderTransform>
                                                        <ui:Icon.Style>
                                                            <Style TargetType="ui:Icon">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                        <DataTrigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" To="180" Duration="0:0:0.25">
                                                                                        <DoubleAnimation.EasingFunction>
                                                                                            <BackEase Amplitude="0.4" EasingMode="EaseOut" />
                                                                                        </DoubleAnimation.EasingFunction>
                                                                                    </DoubleAnimation>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.EnterActions>
                                                                        <DataTrigger.ExitActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" To="0" Duration="0:0:0.25">
                                                                                        <DoubleAnimation.EasingFunction>
                                                                                            <BackEase Amplitude="0.4" EasingMode="EaseOut" />
                                                                                        </DoubleAnimation.EasingFunction>
                                                                                    </DoubleAnimation>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.ExitActions>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:Icon.Style>
                                                    </ui:Icon>
                                                </Grid>

                                                <!-- expanded part -->
                                                <StackPanel Margin="48,0,0,0" Visibility="Collapsed" local:Reveal.IsOpen="{Binding IsExpanded}">
                                                    <TextBlock Style="{DynamicResource Text.Body}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding Text}" />
                                                    <ItemsControl ItemsSource="{Binding Actions}" Margin="-3,8,0,0" Focusable="False"
                                                                  Visibility="{Binding HasActions, Converter={conv:BoolToVisibility}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <ui:M3Button Margin="3" Content="{Binding}" Variant="Outlined" Size="S"
                                                                             Command="{Binding DataContext.InvokeActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                             CommandParameter="{Binding}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <DockPanel Margin="0,8,0,0" Visibility="{Binding CanReply, Converter={conv:BoolToVisibility}}">
                                                        <ui:IconButton DockPanel.Dock="Right" Icon="send" Variant="Filled" Size="40" Margin="8,0,0,0"
                                                                       Command="{Binding SendReplyCommand}" ToolTip="{DynamicResource phone.send}" />
                                                        <TextBox Style="{DynamicResource TextField}" ui:Field.Placeholder="{DynamicResource phone.replyPlaceholder}"
                                                                 ui:Field.Icon="reply" Text="{Binding ReplyText, UpdateSourceTrigger=PropertyChanged}">
                                                            <TextBox.InputBindings>
                                                                <KeyBinding Key="Return" Command="{Binding SendReplyCommand}" />
                                                            </TextBox.InputBindings>
                                                        </TextBox>
                                                    </DockPanel>
                                                    <ui:M3Button Margin="0,8,0,0" HorizontalAlignment="Right" Content="{DynamicResource phone.dismiss}" Icon="close"
                                                                 Variant="Text" Size="S" Command="{Binding DismissCommand}"
                                                                 Visibility="{Binding CanDismiss, Converter={conv:BoolToVisibility}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
