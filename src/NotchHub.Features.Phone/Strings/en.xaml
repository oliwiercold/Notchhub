<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Keys MUST be prefixed with "phone." -->
    <sys:String x:Key="phone.placeholder">Phone</sys:String>
    <sys:String x:Key="phone.disabledTitle">Phone is turned off</sys:String>
    <sys:String x:Key="phone.disabledBody">The phone connection (KDE Connect compatible) is disabled. Turn it on to see battery, notifications and share the clipboard.</sys:String>
    <sys:String x:Key="phone.enable">Turn on</sys:String>
    <sys:String x:Key="phone.setupTitle">Connect your phone</sys:String>
    <sys:String x:Key="phone.setupSubtitle">NotchHub acts as a KDE Connect device</sys:String>
    <sys:String x:Key="phone.step1Title">Install KDE Connect</sys:String>
    <sys:String x:Key="phone.step1Body">Get the KDE Connect app on your phone from Google Play or F-Droid.</sys:String>
    <sys:String x:Key="phone.step2Title">Same Wi-Fi network</sys:String>
    <sys:String x:Key="phone.step2Body">Your phone and this PC must be on the same local network.</sys:String>
    <sys:String x:Key="phone.step3Title">Allow in Windows Firewall</sys:String>
    <sys:String x:Key="phone.step3Body">If a Windows Firewall prompt appears, allow NotchHub on private networks.</sys:String>
    <sys:String x:Key="phone.step4Title">Pair</sys:String>
    <sys:String x:Key="phone.step4BodyA">Open KDE Connect on your phone, pick “</sys:String>
    <sys:String x:Key="phone.step4BodyB">” and tap “Request pairing” - or pair from the list on the right.</sys:String>
    <sys:String x:Key="phone.nearby">NEARBY DEVICES</sys:String>
    <sys:String x:Key="phone.noDevices">No phone found yet.</sys:String>
    <sys:String x:Key="phone.searching">Looking for devices…</sys:String>
    <sys:String x:Key="phone.refresh">Refresh</sys:String>
    <sys:String x:Key="phone.pair">Pair</sys:String>
    <sys:String x:Key="phone.waitingTitle">Waiting for the phone…</sys:String>
    <sys:String x:Key="phone.waitingBody">Confirm pairing on your phone and check that the key matches.</sys:String>
    <sys:String x:Key="phone.incomingTitle">Pairing request</sys:String>
    <sys:String x:Key="phone.incomingBody">Accept only if the key matches the one on your phone.</sys:String>
    <sys:String x:Key="phone.keyLabel">VERIFICATION KEY</sys:String>
    <sys:String x:Key="phone.accept">Accept</sys:String>
    <sys:String x:Key="phone.reject">Reject</sys:String>
    <sys:String x:Key="phone.statusConnected">Connected • Wi-Fi</sys:String>
    <sys:String x:Key="phone.statusOffline">Offline</sys:String>
    <sys:String x:Key="phone.more">More</sys:String>
    <sys:String x:Key="phone.unpair">Unpair</sys:String>
    <sys:String x:Key="phone.battery">battery</sys:String>
    <sys:String x:Key="phone.ring">Ring</sys:String>
    <sys:String x:Key="phone.ping">Ping</sys:String>
    <sys:String x:Key="phone.sendClipboard">Clipboard</sys:String>
    <sys:String x:Key="phone.notifications">Notifications</sys:String>
    <sys:String x:Key="phone.clearAll">Clear all</sys:String>
    <sys:String x:Key="phone.noNotifications">No notifications</sys:String>
    <sys:String x:Key="phone.offlineTitle">Phone is offline</sys:String>
    <sys:String x:Key="phone.offlineBody">Notifications were cleared. They will show up again when the phone reconnects.</sys:String>
    <sys:String x:Key="phone.replyPlaceholder">Reply…</sys:String>
    <sys:String x:Key="phone.send">Send</sys:String>
    <sys:String x:Key="phone.dismiss">Dismiss</sys:String>
    <sys:String x:Key="phone.replySent">Reply sent</sys:String>
    <sys:String x:Key="phone.ringSent">Phone is ringing</sys:String>
    <sys:String x:Key="phone.pingSent">Ping sent</sys:String>
    <sys:String x:Key="phone.clipboardSent">Clipboard sent</sys:String>
    <sys:String x:Key="phone.sendFailed">Could not send - check the phone connection</sys:String>
    <sys:String x:Key="phone.clipboardEmpty">Clipboard is empty</sys:String>
    <sys:String x:Key="phone.batteryUnknown">No battery data</sys:String>
    <sys:String x:Key="phone.batteryLastKnown">last known</sys:String>
    <sys:String x:Key="phone.callRinging">Incoming call</sys:String>
    <sys:String x:Key="phone.callTalking">Call in progress</sys:String>
    <sys:String x:Key="phone.callMissed">Missed call</sys:String>
    <sys:String x:Key="phone.callUnknown">Unknown number</sys:String>
    <sys:String x:Key="phone.mute">Mute</sys:String>
    <sys:String x:Key="phone.muted">Muted</sys:String>
    <sys:String x:Key="phone.copyCode">Copy code</sys:String>
    <sys:String x:Key="phone.codeCopied">Code copied</sys:String>
    <sys:String x:Key="phone.swipeHint">Swipe sideways to dismiss</sys:String>
</ResourceDictionary>
