<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Keys MUST be prefixed with "phone." -->
    <sys:String x:Key="phone.placeholder">Telefon</sys:String>
    <sys:String x:Key="phone.disabledTitle">Telefon jest wyłączony</sys:String>
    <sys:String x:Key="phone.disabledBody">Połączenie z telefonem (zgodne z KDE Connect) jest wyłączone. Włącz je, aby widzieć baterię, powiadomienia i wymieniać schowek.</sys:String>
    <sys:String x:Key="phone.enable">Włącz</sys:String>
    <sys:String x:Key="phone.setupTitle">Połącz telefon</sys:String>
    <sys:String x:Key="phone.setupSubtitle">NotchHub działa jak urządzenie KDE Connect</sys:String>
    <sys:String x:Key="phone.step1Title">Zainstaluj KDE Connect</sys:String>
    <sys:String x:Key="phone.step1Body">Pobierz aplikację KDE Connect na telefon ze Sklepu Google Play lub F-Droid.</sys:String>
    <sys:String x:Key="phone.step2Title">Ta sama sieć Wi-Fi</sys:String>
    <sys:String x:Key="phone.step2Body">Telefon i komputer muszą być w tej samej sieci lokalnej.</sys:String>
    <sys:String x:Key="phone.step3Title">Zezwól w zaporze Windows</sys:String>
    <sys:String x:Key="phone.step3Body">Jeśli pojawi się okno Zapory Windows, zezwól NotchHub na dostęp do sieci prywatnej.</sys:String>
    <sys:String x:Key="phone.step4Title">Sparuj</sys:String>
    <sys:String x:Key="phone.step4BodyA">Otwórz KDE Connect na telefonie, wybierz „</sys:String>
    <sys:String x:Key="phone.step4BodyB">” i stuknij „Poproś o parowanie” - albo sparuj z listy obok.</sys:String>
    <sys:String x:Key="phone.nearby">URZĄDZENIA W POBLIŻU</sys:String>
    <sys:String x:Key="phone.noDevices">Nie znaleziono jeszcze żadnego telefonu.</sys:String>
    <sys:String x:Key="phone.searching">Szukam urządzeń…</sys:String>
    <sys:String x:Key="phone.refresh">Odśwież</sys:String>
    <sys:String x:Key="phone.pair">Sparuj</sys:String>
    <sys:String x:Key="phone.waitingTitle">Czekam na telefon…</sys:String>
    <sys:String x:Key="phone.waitingBody">Potwierdź parowanie na telefonie i sprawdź, czy klucz jest taki sam.</sys:String>
    <sys:String x:Key="phone.incomingTitle">Prośba o sparowanie</sys:String>
    <sys:String x:Key="phone.incomingBody">Akceptuj tylko, jeśli klucz zgadza się z tym na telefonie.</sys:String>
    <sys:String x:Key="phone.keyLabel">KLUCZ WERYFIKACYJNY</sys:String>
    <sys:String x:Key="phone.accept">Akceptuj</sys:String>
    <sys:String x:Key="phone.reject">Odrzuć</sys:String>
    <sys:String x:Key="phone.statusConnected">Połączono • Wi-Fi</sys:String>
    <sys:String x:Key="phone.statusOffline">Offline</sys:String>
    <sys:String x:Key="phone.more">Więcej</sys:String>
    <sys:String x:Key="phone.unpair">Usuń parowanie</sys:String>
    <sys:String x:Key="phone.battery">bateria</sys:String>
    <sys:String x:Key="phone.ring">Zadzwoń</sys:String>
    <sys:String x:Key="phone.ping">Ping</sys:String>
    <sys:String x:Key="phone.sendClipboard">Schowek</sys:String>
    <sys:String x:Key="phone.notifications">Powiadomienia</sys:String>
    <sys:String x:Key="phone.clearAll">Wyczyść wszystko</sys:String>
    <sys:String x:Key="phone.noNotifications">Brak powiadomień</sys:String>
    <sys:String x:Key="phone.offlineTitle">Telefon jest offline</sys:String>
    <sys:String x:Key="phone.offlineBody">Powiadomienia zostały wyczyszczone. Pojawią się ponownie, gdy telefon się połączy.</sys:String>
    <sys:String x:Key="phone.replyPlaceholder">Odpowiedz…</sys:String>
    <sys:String x:Key="phone.send">Wyślij</sys:String>
    <sys:String x:Key="phone.dismiss">Odrzuć</sys:String>
    <sys:String x:Key="phone.replySent">Wysłano odpowiedź</sys:String>
    <sys:String x:Key="phone.ringSent">Telefon dzwoni</sys:String>
    <sys:String x:Key="phone.pingSent">Wysłano ping</sys:String>
    <sys:String x:Key="phone.clipboardSent">Wysłano schowek</sys:String>
    <sys:String x:Key="phone.clipboardEmpty">Schowek jest pusty</sys:String>
    <sys:String x:Key="phone.batteryUnknown">Brak danych o baterii</sys:String>
    <sys:String x:Key="phone.batteryLastKnown">ostatni odczyt</sys:String>
    <sys:String x:Key="phone.callRinging">Połączenie przychodzące</sys:String>
    <sys:String x:Key="phone.callTalking">Trwa rozmowa</sys:String>
    <sys:String x:Key="phone.callMissed">Nieodebrane połączenie</sys:String>
    <sys:String x:Key="phone.callUnknown">Nieznany numer</sys:String>
    <sys:String x:Key="phone.mute">Wycisz</sys:String>
    <sys:String x:Key="phone.muted">Wyciszono</sys:String>
    <sys:String x:Key="phone.copyCode">Kopiuj kod</sys:String>
    <sys:String x:Key="phone.codeCopied">Skopiowano kod</sys:String>
    <sys:String x:Key="phone.swipeHint">Przesuń w bok, aby usunąć</sys:String>
</ResourceDictionary>
