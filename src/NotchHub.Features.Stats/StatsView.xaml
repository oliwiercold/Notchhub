<UserControl x:Class="NotchHub.Features.Stats.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:NotchHub.UI.Controls;assembly=NotchHub.UI"
             xmlns:conv="clr-namespace:NotchHub.UI.Converters;assembly=NotchHub.UI"
             xmlns:local="clr-namespace:NotchHub.Features.Stats"
             Width="792" Foreground="{DynamicResource Brush.OnSurface}"
             Typography.NumeralAlignment="Tabular">
    <UserControl.Resources>
        <Style x:Key="StatChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Margin" Value="2,0" />
        </Style>
        <Style x:Key="GaugeCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="12,16" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="284" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ───── CPU ───── -->
        <Border Style="{StaticResource GaugeCard}">
            <StackPanel VerticalAlignment="Center">
                <ui:WavyRing Width="96" Height="96" Value="{Binding CpuValue}" ActiveBrush="{DynamicResource Brush.Gauge.Cpu}">
                    <TextBlock Style="{DynamicResource Text.Number}" Text="{Binding CpuText}" />
                </ui:WavyRing>
                <TextBlock Style="{DynamicResource Text.Title}" Text="{DynamicResource stats.cpu}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                <TextBlock Style="{DynamicResource Text.BodyS}" Text="{Binding CpuName}" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding CpuName}" Margin="0,2,0,10" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Style="{StaticResource StatChip}" Visibility="{Binding CpuClock, Converter={conv:NullToVisibility}}">
                        <TextBlock Style="{DynamicResource Text.LabelS}" Text="{Binding CpuClock}" />
                    </Border>
                    <Border Style="{StaticResource StatChip}">
                        <TextBlock Style="{DynamicResource Text.LabelS}" Text="{Binding CpuProcs}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ───── GPU ───── -->
        <Border Grid.Column="2" Style="{StaticResource GaugeCard}">
            <StackPanel VerticalAlignment="Center">
                <ui:WavyRing Width="96" Height="96" Value="{Binding GpuValue}" ActiveBrush="{DynamicResource Brush.Gauge.Gpu}">
                    <TextBlock Style="{DynamicResource Text.Number}" Text="{Binding GpuText}" />
                </ui:WavyRing>
                <TextBlock Style="{DynamicResource Text.Title}" Text="{DynamicResource stats.gpu}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                <TextBlock Style="{DynamicResource Text.BodyS}" Text="{Binding GpuName}" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding GpuName}" Margin="0,2,0,10" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" MinHeight="22">
                    <Border Style="{StaticResource StatChip}" Visibility="{Binding GpuVram, Converter={conv:NullToVisibility}}">
                        <TextBlock Style="{DynamicResource Text.LabelS}" Text="{Binding GpuVram}" />
                    </Border>
                    <Border Style="{StaticResource StatChip}" Visibility="{Binding GpuTemp, Converter={conv:NullToVisibility}}">
                        <TextBlock Style="{DynamicResource Text.LabelS}" Text="{Binding GpuTemp}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ───── RAM ───── -->
        <Border Grid.Column="4" Style="{StaticResource GaugeCard}">
            <StackPanel VerticalAlignment="Center">
                <ui:WavyRing Width="96" Height="96" Value="{Binding RamValue}" ActiveBrush="{DynamicResource Brush.Gauge.Ram}">
                    <TextBlock Style="{DynamicResource Text.Number}" Text="{Binding RamText}" />
                </ui:WavyRing>
                <TextBlock Style="{DynamicResource Text.Title}" Text="{DynamicResource stats.ram}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                <TextBlock Style="{DynamicResource Text.BodyS}" Text="{Binding RamDetail}" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,10" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Style="{StaticResource StatChip}">
                        <TextBlock Style="{DynamicResource Text.LabelS}" Text="{Binding RamFree}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ───── Disk ───── -->
        <Border Grid.Row="2" Style="{DynamicResource CardTight}" Padding="16,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:Icon Glyph="hard_drive" Size="14" Foreground="{DynamicResource Brush.OnSurfaceMuted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Style="{DynamicResource Text.Overline}" Text="{Binding DiskTitle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{DynamicResource Text.TitleL}" Text="{Binding DiskText}" Margin="0,6,0,8" />
                <local:RatioBar Value="{Binding DiskFraction}" Fill="{DynamicResource Brush.Primary}" Track="{DynamicResource Brush.Surface3}" />
            </StackPanel>
        </Border>

        <!-- ───── Network ───── -->
        <Border Grid.Row="2" Grid.Column="2" Style="{DynamicResource CardTight}" Padding="16,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:Icon Glyph="speed" Size="14" Foreground="{DynamicResource Brush.OnSurfaceMuted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Style="{DynamicResource Text.Overline}" Text="{DynamicResource stats.network}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:Icon Glyph="arrow_downward" Size="16" Foreground="{DynamicResource Brush.Primary}" VerticalAlignment="Center" />
                        <TextBlock Style="{DynamicResource Text.Title}" Text="{Binding NetDown}" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <ui:Icon Glyph="arrow_upward" Size="16" Foreground="{DynamicResource Brush.Tertiary}" VerticalAlignment="Center" />
                        <TextBlock Style="{DynamicResource Text.Title}" Text="{Binding NetUp}" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ───── Uptime ───── -->
        <Border Grid.Row="2" Grid.Column="4" Style="{DynamicResource CardTight}" Padding="16,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:Icon Glyph="schedule" Size="14" Foreground="{DynamicResource Brush.OnSurfaceMuted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Style="{DynamicResource Text.Overline}" Text="{DynamicResource stats.uptime}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{DynamicResource Text.TitleL}" Text="{Binding UptimeText}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- ───── Right column ───── -->
        <Grid Grid.Column="6" Grid.RowSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top apps -->
            <Border Style="{DynamicResource CardTight}" Padding="14,10,14,12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{DynamicResource Text.LabelS}" Text="{Binding TopTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <ui:M3Button Grid.Column="1" Variant="Text" Size="S" Icon="swap_horiz" Content="{Binding SortToggleText}"
                                     Command="{Binding ToggleSortCommand}" ToolTip="{DynamicResource stats.sortToggleTip}" Margin="4,-4,-8,-4" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding TopApps}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:TopAppItem}">
                                <Grid Margin="0,3" Height="30" Visibility="{Binding IsVisible, Converter={conv:BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:Avatar Text="{Binding Name}" Size="24" VerticalAlignment="Center"
                                               Visibility="{Binding Icon, Converter={conv:NullToVisibility}, ConverterParameter=Invert}" />
                                    <Image Width="22" Height="22" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{Binding Icon, Converter={conv:BytesToImage}, ConverterParameter=32}"
                                           Visibility="{Binding Icon, Converter={conv:NullToVisibility}}" />
                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{DynamicResource Text.Label}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Style="{DynamicResource Text.LabelS}" Text="{Binding ValueText}" MinWidth="44"
                                                   TextAlignment="Right" Margin="8,0,0,0" />
                                        <local:RatioBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0" Value="{Binding Fraction}"
                                                        Fill="{DynamicResource Brush.Gauge.Ram}" Track="{DynamicResource Brush.Surface3}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Internet speed -->
            <Border Grid.Row="2" Style="{DynamicResource CardTight}" Padding="14,12">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.Title}" Text="{DynamicResource stats.speedTitle}" />
                    <TextBlock Style="{DynamicResource Text.BodyS}" Text="{Binding SpeedInfo}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                               Visibility="{Binding SpeedFailed, Converter={conv:BoolToVisibility}, ConverterParameter=Invert}" />
                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0" Visibility="{Binding SpeedFailed, Converter={conv:BoolToVisibility}}">
                        <ui:Icon Glyph="error" Size="14" Foreground="{DynamicResource Brush.Error}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Style="{DynamicResource Text.Body}" Foreground="{DynamicResource Brush.Error}" Text="{DynamicResource stats.speedFailed}" />
                    </StackPanel>

                    <!-- idle / result -->
                    <StackPanel Visibility="{Binding SpeedRunning, Converter={conv:BoolToVisibility}, ConverterParameter=Invert}">
                        <Grid Margin="0,8,0,10" Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Style="{DynamicResource Text.Headline}" Text="{Binding SpeedDown}" />
                                <TextBlock Style="{DynamicResource Text.LabelS}" Text="{DynamicResource stats.mbpsDown}" Margin="4,0,0,5" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Style="{DynamicResource Text.Headline}" Text="{Binding SpeedUp}" />
                                <TextBlock Style="{DynamicResource Text.LabelS}" Text="{DynamicResource stats.mbpsUp}" Margin="4,0,0,5" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                <TextBlock Style="{DynamicResource Text.Label}" Text="{Binding SpeedPing}" HorizontalAlignment="Right" />
                                <TextBlock Style="{DynamicResource Text.LabelS}" Text="{DynamicResource stats.ping}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <ui:M3Button Variant="Filled" Size="M" Icon="play_arrow" HorizontalAlignment="Stretch"
                                         Content="{DynamicResource stats.speedRun}" Command="{Binding RunSpeedTestCommand}"
                                         Visibility="{Binding SpeedFailed, Converter={conv:BoolToVisibility}, ConverterParameter=Invert}" />
                            <ui:M3Button Variant="Tonal" Size="M" Icon="refresh" HorizontalAlignment="Stretch"
                                         Content="{DynamicResource stats.speedRetry}" Command="{Binding RunSpeedTestCommand}"
                                         Visibility="{Binding SpeedFailed, Converter={conv:BoolToVisibility}}" />
                        </Grid>
                    </StackPanel>

                    <!-- running -->
                    <StackPanel Visibility="{Binding SpeedRunning, Converter={conv:BoolToVisibility}}">
                        <Grid Margin="0,8,0,8" Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:LoadingIndicator Size="36" IsActive="{Binding SpeedRunning}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{DynamicResource Text.LabelS}" Text="{Binding SpeedPhaseText}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{DynamicResource Text.Number}" Text="{Binding SpeedLive}" MinWidth="44" />
                                    <TextBlock Style="{DynamicResource Text.LabelS}" Text="{DynamicResource stats.mbps}" Margin="4,0,0,3" VerticalAlignment="Bottom" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <ui:WavyProgressBar Value="{Binding SpeedProgress}" IsWavy="{Binding SpeedRunning}" IsAnimating="{Binding SpeedRunning}"
                                            Height="12" Margin="0,0,0,8" />
                        <ui:M3Button Variant="Outlined" Size="S" Icon="close" HorizontalAlignment="Stretch"
                                     Content="{DynamicResource stats.speedCancel}" Command="{Binding CancelSpeedTestCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
