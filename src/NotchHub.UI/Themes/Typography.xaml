<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- TextBlock styles (docs/DESIGN.md §2). Foreground is inherited unless the style says otherwise. -->
    <Style x:Key="Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Sans}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
    </Style>

    <Style x:Key="Text.Display" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.SansRounded}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="56" />
        <Setter Property="LineHeight" Value="56" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>
    <Style x:Key="Text.Headline" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.SansRounded}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="30" />
    </Style>
    <Style x:Key="Text.Number" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.SansRounded}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="22" />
    </Style>
    <Style x:Key="Text.TitleL" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="17" />
    </Style>
    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="Text.BodyS" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>
    <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="Text.LabelS" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>
    <Style x:Key="Text.Overline" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceMuted}" />
    </Style>
</ResourceDictionary>
