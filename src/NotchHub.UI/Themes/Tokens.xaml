<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:ui="clr-namespace:NotchHub.UI">
    <!--
        DESIGN TOKENS (see docs/DESIGN.md).
        Default values = the gold dark scheme of the reference screenshots. At runtime ThemeService replaces every
        "Brush.*" entry in Application.Resources with a live (non-frozen) brush and animates its Color, so:
          * ALWAYS reference brushes with {DynamicResource Brush.X}, never StaticResource.
          * Never hard-code colors in views (except pure transparent / pure black of the notch body via Brush.Panel).
        "Color.*" entries are the same values as Color (for custom drawing code that needs a Color).
    -->

    <!-- ── Surfaces (dark, neutral palette) ── -->
    <Color x:Key="Color.Panel">#FF000000</Color>
    <Color x:Key="Color.Surface1">#FF161618</Color>
    <Color x:Key="Color.Surface2">#FF1F1F22</Color>
    <Color x:Key="Color.Surface3">#FF29292D</Color>
    <Color x:Key="Color.Surface4">#FF333338</Color>
    <Color x:Key="Color.OnSurface">#FFEDE7DB</Color>
    <Color x:Key="Color.OnSurfaceVariant">#FFB9B2A5</Color>
    <Color x:Key="Color.OnSurfaceMuted">#FF8A857C</Color>
    <Color x:Key="Color.Outline">#FF4C4840</Color>
    <Color x:Key="Color.OutlineVariant">#FF2E2C28</Color>

    <!-- ── Accent (primary palette) ── -->
    <Color x:Key="Color.Primary">#FFDAB862</Color>
    <Color x:Key="Color.OnPrimary">#FF3B2F00</Color>
    <Color x:Key="Color.PrimaryContainer">#FF574618</Color>
    <Color x:Key="Color.OnPrimaryContainer">#FFF7E2A8</Color>
    <Color x:Key="Color.PrimarySoft">#FFF4E6C6</Color>
    <Color x:Key="Color.OnPrimarySoft">#FF251B00</Color>

    <Color x:Key="Color.Secondary">#FFD4C6A1</Color>
    <Color x:Key="Color.OnSecondary">#FF392F15</Color>
    <Color x:Key="Color.SecondaryContainer">#FF3F3A2A</Color>
    <Color x:Key="Color.OnSecondaryContainer">#FFEFDFB6</Color>

    <Color x:Key="Color.Tertiary">#FFCDB9F2</Color>
    <Color x:Key="Color.OnTertiary">#FF35275A</Color>
    <Color x:Key="Color.TertiaryContainer">#FF4B3D72</Color>
    <Color x:Key="Color.OnTertiaryContainer">#FFE9DDFF</Color>

    <Color x:Key="Color.Error">#FFFFB4AB</Color>
    <Color x:Key="Color.OnError">#FF690005</Color>
    <Color x:Key="Color.ErrorContainer">#FF93000A</Color>
    <Color x:Key="Color.OnErrorContainer">#FFFFDAD6</Color>

    <!-- Harmonized extended colors (blended towards the source hue at runtime) -->
    <Color x:Key="Color.Success">#FFA9D98B</Color>
    <Color x:Key="Color.OnSuccess">#FF173800</Color>
    <Color x:Key="Color.Warning">#FFF3C46E</Color>
    <Color x:Key="Color.Info">#FF9CCBFB</Color>
    <Color x:Key="Color.Pink">#FFF28FAD</Color>

    <!-- Data colors -->
    <Color x:Key="Color.Gauge.Cpu">#FFDAB862</Color>
    <Color x:Key="Color.Gauge.Gpu">#FFCDB9F2</Color>
    <Color x:Key="Color.Gauge.Ram">#FFA9D98B</Color>

    <!-- State layers (M3: hover 8%, pressed 12% of the content color) -->
    <Color x:Key="Color.StateHover">#14FFFFFF</Color>
    <Color x:Key="Color.StatePressed">#1FFFFFFF</Color>
    <Color x:Key="Color.Scrim">#99000000</Color>

    <SolidColorBrush x:Key="Brush.Panel" Color="#FF000000" />
    <SolidColorBrush x:Key="Brush.Surface1" Color="#FF161618" />
    <SolidColorBrush x:Key="Brush.Surface2" Color="#FF1F1F22" />
    <SolidColorBrush x:Key="Brush.Surface3" Color="#FF29292D" />
    <SolidColorBrush x:Key="Brush.Surface4" Color="#FF333338" />
    <SolidColorBrush x:Key="Brush.OnSurface" Color="#FFEDE7DB" />
    <SolidColorBrush x:Key="Brush.OnSurfaceVariant" Color="#FFB9B2A5" />
    <SolidColorBrush x:Key="Brush.OnSurfaceMuted" Color="#FF8A857C" />
    <SolidColorBrush x:Key="Brush.Outline" Color="#FF4C4840" />
    <SolidColorBrush x:Key="Brush.OutlineVariant" Color="#FF2E2C28" />
    <SolidColorBrush x:Key="Brush.Primary" Color="#FFDAB862" />
    <SolidColorBrush x:Key="Brush.OnPrimary" Color="#FF3B2F00" />
    <SolidColorBrush x:Key="Brush.PrimaryContainer" Color="#FF574618" />
    <SolidColorBrush x:Key="Brush.OnPrimaryContainer" Color="#FFF7E2A8" />
    <SolidColorBrush x:Key="Brush.PrimarySoft" Color="#FFF4E6C6" />
    <SolidColorBrush x:Key="Brush.OnPrimarySoft" Color="#FF251B00" />
    <SolidColorBrush x:Key="Brush.Secondary" Color="#FFD4C6A1" />
    <SolidColorBrush x:Key="Brush.OnSecondary" Color="#FF392F15" />
    <SolidColorBrush x:Key="Brush.SecondaryContainer" Color="#FF3F3A2A" />
    <SolidColorBrush x:Key="Brush.OnSecondaryContainer" Color="#FFEFDFB6" />
    <SolidColorBrush x:Key="Brush.Tertiary" Color="#FFCDB9F2" />
    <SolidColorBrush x:Key="Brush.OnTertiary" Color="#FF35275A" />
    <SolidColorBrush x:Key="Brush.TertiaryContainer" Color="#FF4B3D72" />
    <SolidColorBrush x:Key="Brush.OnTertiaryContainer" Color="#FFE9DDFF" />
    <SolidColorBrush x:Key="Brush.Error" Color="#FFFFB4AB" />
    <SolidColorBrush x:Key="Brush.OnError" Color="#FF690005" />
    <SolidColorBrush x:Key="Brush.ErrorContainer" Color="#FF93000A" />
    <SolidColorBrush x:Key="Brush.OnErrorContainer" Color="#FFFFDAD6" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FFA9D98B" />
    <SolidColorBrush x:Key="Brush.OnSuccess" Color="#FF173800" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFF3C46E" />
    <SolidColorBrush x:Key="Brush.Info" Color="#FF9CCBFB" />
    <SolidColorBrush x:Key="Brush.Pink" Color="#FFF28FAD" />
    <SolidColorBrush x:Key="Brush.Gauge.Cpu" Color="#FFDAB862" />
    <SolidColorBrush x:Key="Brush.Gauge.Gpu" Color="#FFCDB9F2" />
    <SolidColorBrush x:Key="Brush.Gauge.Ram" Color="#FFA9D98B" />
    <SolidColorBrush x:Key="Brush.StateHover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.StatePressed" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="#99000000" />

    <!-- ── Fonts ── -->
    <x:Static x:Key="Font.Sans" Member="ui:NhFonts.Sans" />
    <x:Static x:Key="Font.SansRounded" Member="ui:NhFonts.SansRounded" />
    <x:Static x:Key="Font.Symbols" Member="ui:NhFonts.Symbols" />
    <x:Static x:Key="Font.SymbolsFilled" Member="ui:NhFonts.SymbolsFilled" />

    <!-- ── Shape (corner radii, M3 Expressive scale) ── -->
    <CornerRadius x:Key="Radius.XS">8</CornerRadius>
    <CornerRadius x:Key="Radius.S">12</CornerRadius>
    <CornerRadius x:Key="Radius.M">16</CornerRadius>
    <CornerRadius x:Key="Radius.L">20</CornerRadius>
    <CornerRadius x:Key="Radius.XL">24</CornerRadius>
    <CornerRadius x:Key="Radius.XXL">28</CornerRadius>
    <CornerRadius x:Key="Radius.Full">999</CornerRadius>
    <sys:Double x:Key="Radius.Card">24</sys:Double>

    <!-- ── Spacing (4 dp grid) ── -->
    <sys:Double x:Key="Space.XS">4</sys:Double>
    <sys:Double x:Key="Space.S">8</sys:Double>
    <sys:Double x:Key="Space.M">12</sys:Double>
    <sys:Double x:Key="Space.L">16</sys:Double>
    <sys:Double x:Key="Space.XL">24</sys:Double>
    <Thickness x:Key="Pad.Card">16</Thickness>
    <Thickness x:Key="Pad.Panel">14,10,14,14</Thickness>
</ResourceDictionary>
