<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Shared strings, keys prefixed with "common." -->
    <sys:String x:Key="common.on">Włączone</sys:String>
    <sys:String x:Key="common.off">Wyłączone</sys:String>
    <sys:String x:Key="common.ok">OK</sys:String>
    <sys:String x:Key="common.cancel">Anuluj</sys:String>
    <sys:String x:Key="common.close">Zamknij</sys:String>
    <sys:String x:Key="common.save">Zapisz</sys:String>
    <sys:String x:Key="common.delete">Usuń</sys:String>
    <sys:String x:Key="common.clear">Wyczyść</sys:String>
    <sys:String x:Key="common.retry">Spróbuj ponownie</sys:String>
    <sys:String x:Key="common.settings">Ustawienia</sys:String>
    <sys:String x:Key="common.loading">Wczytywanie…</sys:String>
    <sys:String x:Key="common.unavailable">Niedostępne</sys:String>
    <sys:String x:Key="common.now">teraz</sys:String>
    <sys:String x:Key="common.minutesAgo">{0} min temu</sys:String>
    <sys:String x:Key="common.hoursAgo">{0} godz. temu</sys:String>
    <sys:String x:Key="common.daysAgo">{0} dni temu</sys:String>
    <sys:String x:Key="common.today">Dzisiaj</sys:String>
    <sys:String x:Key="common.yesterday">Wczoraj</sys:String>
    <sys:String x:Key="common.older">Starsze</sys:String>
</ResourceDictionary>
