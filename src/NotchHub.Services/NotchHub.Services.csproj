<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NotchHub.Services</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Internal types are documented where useful; do not demand XML docs on every member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NotchHub.Core\NotchHub.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Ical.Net" Version="5.2.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NotchHub.Services.Tests" />
  </ItemGroup>
</Project>
