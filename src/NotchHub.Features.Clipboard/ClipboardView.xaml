<UserControl x:Class="NotchHub.Features.Clipboard.ClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:NotchHub.UI.Controls;assembly=NotchHub.UI"
             xmlns:conv="clr-namespace:NotchHub.UI.Converters;assembly=NotchHub.UI"
             xmlns:local="clr-namespace:NotchHub.Features.Clipboard"
             xmlns:c="clr-namespace:NotchHub.Core.Contracts;assembly=NotchHub.Core"
             x:Name="Root" Focusable="False"
             Foreground="{DynamicResource Brush.OnSurface}">
    <UserControl.Resources>
        <Style x:Key="Keycap" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
        </Style>

        <DataTemplate x:Key="RowTemplate" DataType="{x:Type local:ClipEntry}">
            <Grid Height="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- kind icon / thumbnail / swatch -->
                <Border x:Name="IconBox" CornerRadius="8" Background="{DynamicResource Brush.Surface3}">
                    <ui:Icon Glyph="{Binding Glyph}" Size="16" Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="ThumbBox" CornerRadius="8" Visibility="Collapsed">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Border x:Name="SwatchBox" CornerRadius="8" Visibility="Collapsed" Background="{Binding Swatch}"
                        BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1" />

                <TextBlock Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" Text="{Binding Title}"
                           Style="{DynamicResource Text.Label}" TextTrimming="CharacterEllipsis" />

                <StackPanel x:Name="Meta" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Icon Glyph="smartphone" Size="14" Margin="0,0,6,0" Foreground="{DynamicResource Brush.Primary}"
                             Visibility="{Binding IsPhone, Converter={conv:BoolToVisibility}}" />
                    <TextBlock Style="{DynamicResource Text.LabelS}" Text="{Binding CopiedAt, Converter={conv:RelativeTime}}" />
                </StackPanel>
                <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed" Margin="0,-4,-6,-4">
                    <ui:IconButton Icon="push_pin" Size="32" IsSelected="{Binding IsPinned, Mode=OneWay}" IconFilled="{Binding IsPinned, Mode=OneWay}"
                                   ToolTip="{DynamicResource clipboard.pin}" Focusable="False"
                                   Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                   CommandParameter="{Binding}" />
                    <ui:IconButton Icon="delete" Size="32" ToolTip="{DynamicResource clipboard.delete}" Focusable="False"
                                   Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                   CommandParameter="{Binding}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasThumb}" Value="True">
                    <Setter TargetName="ThumbBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static c:ClipKind.Color}">
                    <Setter TargetName="SwatchBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Meta" Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="IconBox" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Height="476">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ───────── top bar ───────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{DynamicResource TextField}" ui:Field.Icon="search"
                     ui:Field.Placeholder="{Binding SearchPlaceholder}"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,4,0" VerticalAlignment="Center">
                <ToggleButton Style="{DynamicResource FilterChip}" Content="{DynamicResource clipboard.filter.all}" Margin="0,0,6,0" Click="Chip_Click" Focusable="False"
                              IsChecked="{Binding Filter, Converter={conv:EnumEquals}, ConverterParameter=All}" />
                <ToggleButton Style="{DynamicResource FilterChip}" Content="{DynamicResource clipboard.filter.text}" Margin="0,0,6,0" Click="Chip_Click" Focusable="False"
                              IsChecked="{Binding Filter, Converter={conv:EnumEquals}, ConverterParameter=Text}" />
                <ToggleButton Style="{DynamicResource FilterChip}" Content="{DynamicResource clipboard.filter.images}" Margin="0,0,6,0" Click="Chip_Click" Focusable="False"
                              IsChecked="{Binding Filter, Converter={conv:EnumEquals}, ConverterParameter=Images}" />
                <ToggleButton Style="{DynamicResource FilterChip}" Content="{DynamicResource clipboard.filter.links}" Margin="0,0,6,0" Click="Chip_Click" Focusable="False"
                              IsChecked="{Binding Filter, Converter={conv:EnumEquals}, ConverterParameter=Links}" />
                <ToggleButton Style="{DynamicResource FilterChip}" Content="{DynamicResource clipboard.filter.code}" Click="Chip_Click" Focusable="False"
                              IsChecked="{Binding Filter, Converter={conv:EnumEquals}, ConverterParameter=Code}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:IconButton Icon="delete_sweep" Size="40" Focusable="False" ToolTip="{DynamicResource clipboard.clear}"
                               Command="{Binding AskClearCommand}"
                               IsEnabled="{Binding IsEmpty, Converter={conv:InverseBool}}" />
                <ui:IconButton Icon="settings" Size="40" Focusable="False" ToolTip="{DynamicResource clipboard.settings}"
                               Command="{Binding OpenSettingsCommand}" />
            </StackPanel>
        </Grid>

        <!-- ───────── body ───────── -->
        <Grid Grid.Row="1" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="55*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="45*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Padding="0"
                     ItemContainerStyle="{DynamicResource ListRow}" ItemTemplate="{StaticResource RowTemplate}"
                     SelectionMode="Extended" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                     SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{DynamicResource Text.Overline}" Margin="10,10,0,4" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
            </ListBox>

            <!-- empty states -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="3"
                        Visibility="{Binding IsEmpty, Converter={conv:BoolToVisibility}}">
                <Border Width="64" Height="64" CornerRadius="22" Background="{DynamicResource Brush.Surface2}" HorizontalAlignment="Center">
                    <ui:Icon Glyph="content_paste" Size="30" Foreground="{DynamicResource Brush.OnSurfaceVariant}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Style="{DynamicResource Text.Title}" Margin="0,14,0,4" HorizontalAlignment="Center" Text="{DynamicResource clipboard.empty.title}" />
                <TextBlock Style="{DynamicResource Text.BodyS}" HorizontalAlignment="Center" Text="{DynamicResource clipboard.empty.body}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding NoResults, Converter={conv:BoolToVisibility}}">
                <ui:Icon Glyph="search_off" Size="32" Foreground="{DynamicResource Brush.OnSurfaceVariant}" HorizontalAlignment="Center" />
                <TextBlock Style="{DynamicResource Text.Title}" Margin="0,10,0,4" HorizontalAlignment="Center" Text="{DynamicResource clipboard.noResults.title}" />
                <TextBlock Style="{DynamicResource Text.BodyS}" HorizontalAlignment="Center" Text="{DynamicResource clipboard.noResults.body}" />
            </StackPanel>

            <!-- preview pane -->
            <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="18,16"
                    Visibility="{Binding IsEmpty, Converter={conv:BoolToVisibility}, ConverterParameter=Invert}">
                <Grid>
                    <TextBlock Style="{DynamicResource Text.BodyS}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="{DynamicResource clipboard.nothingSelected}"
                               Visibility="{Binding Current, Converter={conv:NullToVisibility}, ConverterParameter=Invert}" />
                    <Grid DataContext="{Binding Current}" Visibility="{Binding DataContext.Current, ElementName=Root, Converter={conv:NullToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{DynamicResource Text.Overline}" Margin="0,0,0,8" Foreground="{DynamicResource Brush.Primary}"
                                   Text="{Binding DataContext.SelectionText, ElementName=Root}"
                                   Visibility="{Binding DataContext.IsMulti, ElementName=Root, Converter={conv:BoolToVisibility}}" />

                        <!-- text / code -->
                        <TextBox x:Name="PreviewText" Grid.Row="1" Text="{Binding FullText, Mode=OneWay}" IsReadOnly="True"
                                 Background="Transparent" BorderThickness="0" Padding="0" Foreground="{DynamicResource Brush.OnSurface}"
                                 SelectionBrush="{DynamicResource Brush.Primary}" CaretBrush="{DynamicResource Brush.Primary}"
                                 TextWrapping="Wrap" FontSize="14" VerticalScrollBarVisibility="Auto" IsUndoEnabled="False"
                                 Visibility="{Binding IsTextual, Converter={conv:BoolToVisibility}}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCode}" Value="True">
                                            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                                            <Setter Property="FontSize" Value="13" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- image -->
                        <Image Grid.Row="1" Source="{Binding PreviewImage}" Stretch="Uniform" SizeChanged="RoundImage_SizeChanged"
                               HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding Kind, Converter={conv:EnumEquals}, ConverterParameter=Image}" />

                        <!-- link -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center"
                                    Visibility="{Binding Kind, Converter={conv:EnumEquals}, ConverterParameter=Link}">
                            <Border Width="48" Height="48" CornerRadius="16" Background="{DynamicResource Brush.SecondaryContainer}" HorizontalAlignment="Left">
                                <ui:Icon Glyph="link" Size="24" Foreground="{DynamicResource Brush.OnSecondaryContainer}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Style="{DynamicResource Text.TitleL}" Margin="0,12,0,4" Text="{Binding LinkDomain}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{DynamicResource Text.BodyS}" Text="{Binding FullText}" TextWrapping="Wrap" MaxHeight="80" TextTrimming="CharacterEllipsis" />
                            <ui:M3Button Margin="0,14,0,0" HorizontalAlignment="Left" Variant="Tonal" Size="S" Icon="open_in_new" Focusable="False"
                                         Content="{DynamicResource clipboard.open}"
                                         Command="{Binding DataContext.OpenLinkCommand, ElementName=Root}" CommandParameter="{Binding}" />
                        </StackPanel>

                        <!-- color -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center"
                                    Visibility="{Binding Kind, Converter={conv:EnumEquals}, ConverterParameter=Color}">
                            <Border Height="120" CornerRadius="20" Background="{Binding Swatch}"
                                    BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1" />
                            <TextBlock Style="{DynamicResource Text.Headline}" Margin="0,12,0,0" Text="{Binding Hex}" />
                            <TextBlock Style="{DynamicResource Text.BodyS}" Text="{Binding Rgb}" />
                        </StackPanel>

                        <!-- files -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding Kind, Converter={conv:EnumEquals}, ConverterParameter=Files}">
                            <ItemsControl ItemsSource="{Binding FileNames}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Brush.Surface3}">
                                                <ui:Icon Glyph="description" Size="16" Foreground="{DynamicResource Brush.OnSurfaceVariant}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Style="{DynamicResource Text.Label}"
                                                       Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- metadata -->
                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <Border Style="{DynamicResource Divider}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="22" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{DynamicResource Text.LabelS}" VerticalAlignment="Center" Text="{DynamicResource clipboard.meta.type}" />
                                <TextBlock Grid.Column="1" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Text="{Binding TypeText}" />
                                <TextBlock Grid.Row="1" Style="{DynamicResource Text.LabelS}" VerticalAlignment="Center" Text="{DynamicResource clipboard.meta.size}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Text="{Binding SizeText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="2" Style="{DynamicResource Text.LabelS}" VerticalAlignment="Center" Text="{DynamicResource clipboard.meta.copied}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Text="{Binding CopiedText}" />
                                <TextBlock Grid.Row="3" Style="{DynamicResource Text.LabelS}" VerticalAlignment="Center" Text="{DynamicResource clipboard.meta.source}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Text="{Binding SourceText}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ───────── footer: key hints / inline clear confirm ───────── -->
        <Grid Grid.Row="2" Height="32">
            <!-- key hints, centered as one group (actions · navigation) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding ConfirmingClear, Converter={conv:BoolToVisibility}, ConverterParameter=Invert}">
                    <Border Style="{StaticResource Keycap}"><ui:Icon Glyph="keyboard_return" Size="13" Foreground="{DynamicResource Brush.OnSurfaceVariant}" /></Border>
                    <TextBlock Style="{StaticResource HintText}" Text="{DynamicResource clipboard.hint.paste}" />
                    <Border Style="{StaticResource Keycap}"><TextBlock Style="{DynamicResource Text.LabelS}" Text="Ctrl C" /></Border>
                    <TextBlock Style="{StaticResource HintText}" Text="{DynamicResource clipboard.hint.copy}" />
                    <Border Style="{StaticResource Keycap}"><TextBlock Style="{DynamicResource Text.LabelS}" Text="Ctrl P" /></Border>
                    <TextBlock Style="{StaticResource HintText}" Text="{DynamicResource clipboard.hint.pin}" />
                    <Border Style="{StaticResource Keycap}"><TextBlock Style="{DynamicResource Text.LabelS}" Text="Del" /></Border>
                    <TextBlock Style="{StaticResource HintText}" Text="{DynamicResource clipboard.hint.delete}" />
                    <Ellipse Width="4" Height="4" Margin="6,0,14,0" VerticalAlignment="Center" Fill="{DynamicResource Brush.OutlineVariant}" />
                    <Border Style="{StaticResource Keycap}"><TextBlock Style="{DynamicResource Text.LabelS}" Text="↑↓" /></Border>
                    <TextBlock Style="{StaticResource HintText}" Text="{DynamicResource clipboard.hint.move}" />
                    <Border Style="{StaticResource Keycap}"><TextBlock Style="{DynamicResource Text.LabelS}" Text="Ctrl/Shift" /></Border>
                    <TextBlock Style="{StaticResource HintText}" Text="{DynamicResource clipboard.hint.multi}" />
                    <Border Style="{StaticResource Keycap}"><TextBlock Style="{DynamicResource Text.LabelS}" Text="Tab" /></Border>
                    <TextBlock Style="{StaticResource HintText}" Margin="0" Text="{DynamicResource clipboard.hint.filter}" />
            </StackPanel>
            <Border CornerRadius="16" Background="{DynamicResource Brush.Surface2}" Padding="12,0,4,0"
                    Visibility="{Binding ConfirmingClear, Converter={conv:BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Icon Glyph="delete_sweep" Size="18" Foreground="{DynamicResource Brush.Error}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Style="{DynamicResource Text.Label}" TextTrimming="CharacterEllipsis"
                               Text="{DynamicResource clipboard.clearConfirm}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:M3Button Variant="Text" Size="S" Focusable="False" Content="{DynamicResource clipboard.cancel}" Command="{Binding CancelClearCommand}" Margin="0,0,4,0" />
                        <ui:M3Button Variant="Filled" Size="S" Focusable="False" Icon="delete_sweep" Content="{DynamicResource clipboard.clearAction}" Command="{Binding ConfirmClearCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
